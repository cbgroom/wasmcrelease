package wasmc:data-relational@0.0.2;

interface relational {
  use wasmc:data-core/types@0.0.1.{batch-snapshot};

  record column-aggregate {
    column: u32,
    alias: string,
  }

  variant aggregate {
    count-all(string),
    count(column-aggregate),
    sum(column-aggregate),
    min(column-aggregate),
    max(column-aggregate),
    mean(column-aggregate),
    first(column-aggregate),
    last(column-aggregate),
    variance-pop(column-aggregate),
    stddev-pop(column-aggregate),
  }

  record join-key {
    left-column: u32,
    right-column: u32,
  }

  enum join-kind {
    inner,
    left,
  }

  record join-options {
    kind: join-kind,
    right-prefix: string,
    max-output-rows: u32,
  }

  record window-order {
    column: u32,
    descending: bool,
    nulls-first: bool,
  }

  variant window-function {
    row-number(string),
    rank(string),
    dense-rank(string),
  }

  record window-options {
    max-rows: u32,
  }

  variant rows-frame-start {
    unbounded,
    preceding(u32),
    current-row,
    following(u32),
  }

  variant rows-frame-end {
    preceding(u32),
    current-row,
    following(u32),
    unbounded,
  }

  record rows-frame {
    start: rows-frame-start,
    end: rows-frame-end,
  }

  record distinct-options {
    max-rows: u32,
  }

  record offset-window {
    column: u32,
    offset: u32,
    alias: string,
  }

  variant offset-window-function {
    lag(offset-window),
    lead(offset-window),
  }

  enum relational-error {
    invalid-batch,
    empty-input,
    empty-keys,
    empty-order,
    empty-functions,
    schema-mismatch,
    key-type-mismatch,
    column-out-of-bounds,
    duplicate-key,
    duplicate-function,
    empty-alias,
    duplicate-output-name,
    invalid-limit,
    row-limit-exceeded,
    output-limit-exceeded,
    unsupported-type,
    unsupported-function,
    invalid-frame,
    overflow,
    compute-failure,
  }

  group-aggregate: func(value: batch-snapshot, keys: list<u32>, aggregates: list<aggregate>) -> result<batch-snapshot, relational-error>;

  union-all: func(values: list<batch-snapshot>) -> result<batch-snapshot, relational-error>;

  equi-join: func(left: batch-snapshot, right: batch-snapshot, keys: list<join-key>, options: join-options) -> result<batch-snapshot, relational-error>;

  window-rank: func(value: batch-snapshot, partition-by: list<u32>, order-by: list<window-order>, functions: list<window-function>, options: window-options) -> result<batch-snapshot, relational-error>;

  distinct: func(value: batch-snapshot, keys: list<u32>, options: distinct-options) -> result<batch-snapshot, relational-error>;

  window-offset: func(value: batch-snapshot, partition-by: list<u32>, order-by: list<window-order>, functions: list<offset-window-function>, options: window-options) -> result<batch-snapshot, relational-error>;

  window-aggregate: func(value: batch-snapshot, partition-by: list<u32>, order-by: list<window-order>, frame: rows-frame, aggregates: list<aggregate>, options: window-options) -> result<batch-snapshot, relational-error>;
}

world data-relational {
  import wasmc:data-core/types@0.0.1;

  export relational;
}
package wasmc:data-core@0.0.1 {
  interface types {
    enum data-type {
      boolean,
      int64,
      uint64,
      %float64,
      utf8,
      binary,
    }

    record field {
      name: string,
      data-type: data-type,
      nullable: bool,
    }

    variant column {
      boolean-column(list<option<bool>>),
      int64-column(list<option<s64>>),
      uint64-column(list<option<u64>>),
      float64-column(list<option<f64>>),
      utf8-column(list<option<string>>),
      binary-column(list<option<list<u8>>>),
    }

    record batch-snapshot {
      rows: u32,
      fields: list<field>,
      columns: list<column>,
    }

    enum data-error {
      column-count-mismatch,
      row-count-mismatch,
      type-mismatch,
      nullability-violation,
      empty-field-name,
      duplicate-field-name,
      index-out-of-bounds,
      invalid-layout,
    }
  }
  interface model {
    use types.{batch-snapshot, data-error};

    validate: func(value: batch-snapshot) -> result<u32, data-error>;

    take: func(value: batch-snapshot, indices: list<u32>) -> result<batch-snapshot, data-error>;
  }
  world data-core {
    export types;
    export model;
  }
}
