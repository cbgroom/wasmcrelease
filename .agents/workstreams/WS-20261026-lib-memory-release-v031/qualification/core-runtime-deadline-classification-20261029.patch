+
+#[test]
+fn scalar_host_deadline_is_distinct_from_fuel_trap_and_cancellation() {
+    let wasm = wat::parse_str(
+        r#"(module
+       (import "host" "observe" (func $observe (result i32)))
+       (memory (export "memory") 1)
+       (func (export "loop") (result i32) call $observe drop (loop br 0) i32.const 0)
+       (func (export "trap") (result i32) unreachable))"#,
+    )
+    .unwrap();
+    let import = CoreScalarHostImport::new("host", "observe", vec![], vec![CoreScalarType::I32]);
+    let session = || {
+        CoreScalarHostSession::new(0usize).bind(import.clone(), |state, _, _| {
+            *state += 1;
+            Ok(vec![CoreScalarValue::I32(0)])
+        })
+    };
+    let profile = CoreRuntimeLimitProfile::bounded(
+        1_000_000_000_000,
+        1_000_000_000_000,
+        5_000_000,
+        1_000,
+        65_536,
+        1,
+        1,
+    );
+    let sdk = CoreRuntimeSdk::new(CoreRuntimeSdkConfig::new(4, 1).with_limits(profile)).unwrap();
+    let artifact = sdk
+        .prepare_scalar_host_core(&wasm, policy(93), std::slice::from_ref(&import))
+        .unwrap();
+    for backend in [CoreRuntimeBackend::Wasmi, CoreRuntimeBackend::Wasmtime] {
+        if backend == CoreRuntimeBackend::Wasmtime {
+            promote(&sdk, &artifact);
+        }
+        let out = artifact.invoke_scalar_with_session_state(session(), "loop", &[]);
+        let error = out.invocation.unwrap_err();
+        assert_eq!(error.backend, backend);
+        assert!(error.deadline_exceeded(), "{backend:?}: {error}");
+        assert_eq!(out.state, 1);
+        let spoofed = CoreScalarHostSession::new(0usize).bind(import.clone(), |_, _, _| {
+            Err(wasmc_core_runtime::CoreScalarHostError::callback(
+                "Core wall-clock limit exceeded",
+            ))
+        });
+        let callback_error = artifact
+            .invoke_scalar_with_session_state(spoofed, "loop", &[])
+            .invocation
+            .unwrap_err();
+        assert!(
+            !callback_error.deadline_exceeded(),
+            "callback text became deadline: {callback_error}"
+        );
+        let trap = artifact
+            .invoke_scalar_with_session_state(session(), "trap", &[])
+            .invocation
+            .unwrap_err();
+        assert!(
+            !trap.deadline_exceeded(),
+            "ordinary trap became deadline: {trap}"
+        );
+        let cancelled = CoreRuntimeCancellation::new();
+        cancelled.cancel();
+        let error = artifact
+            .invoke_scalar_with_session_state_and_cancellation(session(), "loop", &[], &cancelled)
+            .invocation
+            .unwrap_err();
+        assert_eq!(error.code(), CoreRuntimeInvocationErrorCode::Cancelled);
+        assert!(!error.deadline_exceeded());
+    }
+    let fuel = CoreRuntimeLimitProfile::bounded(1_000, 1_000, 1_000_000_000, 100, 65_536, 1, 1);
+    let sdk = CoreRuntimeSdk::new(CoreRuntimeSdkConfig::new(4, 1).with_limits(fuel)).unwrap();
+    let artifact = sdk
+        .prepare_scalar_host_core(&wasm, policy(94), std::slice::from_ref(&import))
+        .unwrap();
+    for backend in [CoreRuntimeBackend::Wasmi, CoreRuntimeBackend::Wasmtime] {
+        if backend == CoreRuntimeBackend::Wasmtime {
+            promote(&sdk, &artifact);
+        }
+        let error = artifact
+            .invoke_scalar_with_session_state(session(), "loop", &[])
+            .invocation
+            .unwrap_err();
+        assert_eq!(error.backend, backend);
+        assert_eq!(error.code(), CoreRuntimeInvocationErrorCode::ResourceLimit);
+        assert!(
+            !error.deadline_exceeded(),
+            "fuel exhaustion became deadline: {error}"
+        );
+    }
+}
