+// Ordered physical plan only: the caller is responsible for resolving the
+// exact activation and checking the route's declared capabilities.
+pub(crate) enum MixedRouteImport {
+    Host(mcpgit_guest_contract::Function),
+    Lib(crate::core_runtime::CoreDomainScalarHostImport),
+}
+pub(crate) struct MixedRoutePlan {
+    pub(crate) ordered: Vec<MixedRouteImport>,
+    pub(crate) imports: Vec<crate::core_runtime::CoreDomainScalarHostImport>,
+    pub(crate) lib: crate::core_lib_call_plan::CoreLibCallPlan,
+}
+pub(crate) fn mixed_route_plan_from_inspection(
+    inspection: &CoreDomainModuleInspection,
+    provider: crate::core_lib::PreparedCoreLib,
+) -> Result<MixedRoutePlan> {
+    use crate::core_runtime::{
+        CoreDomainScalarHostImport as Import, CoreDomainScalarType as Scalar,
+    };
+    fn scalar(value: &CoreDomainModuleValueType) -> Result<Scalar> {
+        match value {
+            CoreDomainModuleValueType::I32 => Ok(Scalar::I32),
+            CoreDomainModuleValueType::I64 => Ok(Scalar::I64),
+            CoreDomainModuleValueType::F32 => Ok(Scalar::F32),
+            CoreDomainModuleValueType::F64 => Ok(Scalar::F64),
+            _ => Err(anyhow!("unsupported mixed route scalar type")),
+        }
+    }
+    let provider_module = format!("wasmc:lib/{}@{}", provider.package_id(), provider.version());
+    let mut ordered = Vec::new();
+    let mut all = Vec::new();
+    let mut lib = Vec::new();
+    let mut provider_import = false;
+    for item in inspection.imports() {
+        let CoreDomainModuleExternType::Function { params, results } = item.external_type() else {
+            return Err(anyhow!("mixed route import is not a function"));
+        };
+        let import = Import::new(
+            item.module(),
+            item.name(),
+            params.iter().map(scalar).collect::<Result<Vec<_>>>()?,
+            results.iter().map(scalar).collect::<Result<Vec<_>>>()?,
+        );
+        if item.module() == "wasmc:private/canonical-memory@1" || item.module() == provider_module {
+            provider_import |= item.module() == provider_module;
+            lib.push(import.clone());
+            ordered.push(MixedRouteImport::Lib(import.clone()));
+        } else {
+            let function = if item.module() == HTTP_HOST_MODULE {
+                let function = mcpgit_guest_contract::find_router(item.module(), item.name())
+                    .ok_or_else(|| anyhow!("unknown route Host import"))?;
+                ensure!(
+                    mcpgit_guest_contract::CANONICAL_ROUTER_FUNCTIONS.contains(function)
+                        || mcpgit_guest_contract::BINARY_EXCHANGE_FUNCTIONS.contains(function),
+                    "unsupported HTTP Host import"
+                );
+                *function
+            } else {
+                let function = mcpgit_guest_contract::find(item.module(), item.name())
+                    .ok_or_else(|| anyhow!("unknown route Host import"))?;
+                ensure!(
+                    programmable_wit_core_supports(*function),
+                    "unsupported programmable Host import"
+                );
+                *function
+            };
+            ensure!(
+                import == mcpgit_programmable_query_runtime::programmable_core_import(function),
+                "route Host import signature mismatch"
+            );
+            ordered.push(MixedRouteImport::Host(function));
+        }
+        all.push(import);
+    }
+    ensure!(
+        provider_import,
+        "selected Core Lib has no imported function"
+    );
+    Ok(MixedRoutePlan {
+        ordered,
+        imports: all,
+        lib: crate::core_lib_call_plan::CoreLibCallPlan::new(provider, lib)?,
+    })
+}
