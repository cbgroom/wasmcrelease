+    #[test]
+    fn mixed_route_planner_rejects_wrong_imports_and_preserves_order() {
+        use super::*;
+        use crate::core_lib::{CoreLibPackage, CoreLibPin, PreparedCoreLib};
+        const MANIFEST: &[u8] =
+            include_bytes!("../tests/fixtures/wasmc-core-algorithms-0.1.0/lib.json");
+        const WIT: &[u8] = include_bytes!("../tests/fixtures/wasmc-core-algorithms-0.1.0/lib.wit");
+        const ARTIFACT: &[u8] =
+            include_bytes!("../tests/fixtures/wasmc-core-algorithms-0.1.0/artifact.wasm");
+        const ABI: &[u8] =
+            include_bytes!("../tests/fixtures/wasmc-core-algorithms-0.1.0/core-abi.json");
+        fn digest(b: &[u8]) -> String {
+            format!("{:x}", Sha256::digest(b))
+        }
+        let provider = PreparedCoreLib::prepare(
+            &Engine::default(),
+            CoreLibPackage {
+                manifest: MANIFEST,
+                wit: WIT,
+                artifact: ARTIFACT,
+                core_abi: ABI,
+            },
+            &CoreLibPin {
+                package_id: "wasmc-core-algorithms".into(),
+                version: "0.1.0".into(),
+                manifest_sha256: digest(MANIFEST),
+                wit_sha256: digest(WIT),
+                artifact_sha256: digest(ARTIFACT),
+                artifact_bytes: ARTIFACT.len(),
+            },
+        )
+        .unwrap();
+        let runtime = CoreDomainRuntime::default();
+        let inspect = |imports: &str| {
+            runtime
+                .inspect_core(&wat::parse_str(format!("(module {imports})")).unwrap())
+                .unwrap()
+        };
+        let lib = r#"(import "wasmc:lib/wasmc-core-algorithms@0.1.0" "wasmc:core-algorithms/algorithms@0.1.0#wrapping-add-s32" (func (param i32 i32) (result i32)))"#;
+        let host = r#"(import "mcpgit:table/v1" "response-drop" (func (param i32) (result i32)))"#;
+        let mixed =
+            mixed_route_plan_from_inspection(&inspect(&format!("{host} {lib}")), provider.clone())
+                .unwrap();
+        assert!(matches!(mixed.ordered[0], MixedRouteImport::Host(_)));
+        assert!(matches!(mixed.ordered[1], MixedRouteImport::Lib(_)));
+        assert_eq!(mixed.imports.len(), 2);
+        let bad_host =
+            r#"(import "mcpgit:table/v1" "response-drop" (func (param i64) (result i32)))"#;
+        assert!(
+            mixed_route_plan_from_inspection(
+                &inspect(&format!("{bad_host} {lib}")),
+                provider.clone()
+            )
+            .is_err()
+        );
+        let bad_lib = r#"(import "wasmc:lib/wasmc-core-algorithms@0.1.0" "wasmc:core-algorithms/algorithms@0.1.0#wrapping-add-s32" (func (param i64) (result i32)))"#;
+        assert!(mixed_route_plan_from_inspection(&inspect(bad_lib), provider.clone()).is_err());
+        let wrong_lib = lib.replace("@0.1.0", "@0.1.1");
+        assert!(mixed_route_plan_from_inspection(&inspect(&wrong_lib), provider.clone()).is_err());
+        assert!(mixed_route_plan_from_inspection(&inspect(host), provider.clone()).is_err());
