+#[test]
+fn frozen_host_receipt_replays_exact_input_modules_without_regeneration() {
+ use wasmc::lib_tool_rust_consumer_sdk::native_build::host::replay_pinned_host_canonical;
+ let product=std::env::var("WASMC_CANONICAL_PRIOR_PRODUCT").unwrap();let fixture=Path::new(&product).join("examples/canonical-host");let assets=fixture.join("producer-assets");
+ let host=HostContractPair{entry:contract(&fixture.join("host/entry"),&[]),operations:contract(&fixture.join("host/operations"),&["table.transact"])};
+ let names=["prepared-transfer.wasm","modules/caller.wasm","prepared-lib-core.wasm","modules/lib-projection.wasm","modules/lib-calls.wasm","modules/canonical-entry.wasm","modules/app-projection.wasm","modules/host-entry.wasm","modules/host-projection.wasm","modules/host-calls.wasm","prepared-core-provider.wasm"];
+ let inputs=names.iter().map(|name|pinned(&assets.join(name))).collect::<Vec<_>>();
+ let receipt=pinned(&assets.join("caller-plan.json"));assert_eq!(receipt.sha256,"f0976bae297b4f1d0788cadfc06ff7ba1b1127824cfe779321a2d9bc30c54b44");let tool=pinned(Path::new(&std::env::var("WASMC_NATIVE_MERGE_TOOL").unwrap()));
+ let out=std::env::var("WASMC_CANONICAL_CHECKED_OUTPUT").unwrap();let stage=Path::new(&out).join(format!("frozen-replay-{}",std::process::id()));let bad_stage=Path::new(&out).join(format!("frozen-replay-invalid-{}",std::process::id()));
+ let mut wrong=inputs.clone();wrong[3].sha256="0".repeat(64);
+ assert!(replay_pinned_host_canonical(&receipt,&wrong,&tool,&host,&bad_stage).is_err());assert!(!bad_stage.exists());
+ let app=replay_pinned_host_canonical(&receipt,&inputs,&tool,&host,&stage).unwrap();
+ assert_eq!(hash(&app.wasm),"9bc7ee1d06e56e61635ba7cf2e00c27f52bec01eba3b881f141af6d3591aa057");
+ assert_eq!(app.plan["artifact"]["sha256"],hash(&app.wasm));
+ assert_eq!(app.plan["replay"]["merge_tool_sha256"],tool.sha256);
+}
