+/// Experimental real-Service invocation with a shared Guest/provider memory budget.
+pub fn invoke_mixed_host_budgeted(
+    provider: &PreparedCoreLib,
+    wasm: &[u8],
+    table_provider: std::sync::Arc<dyn mcpgit_programmable_query_runtime::TableMutationProvider>,
+) -> Result<()> {
+    use crate::core_lib::BudgetedCoreLibInstance;
+    use crate::core_runtime::CoreDomainScalarHostSession;
+    use mcpgit_programmable_query_runtime::{ProgrammableQueryLimits, QueryHost};
+    use wasmtime::StoreLimitsBuilder;
+    struct Extension {
+        lib: BudgetedCoreLibInstance,
+    }
+    let guest = Module::new(&Engine::default(), wasm)?;
+    let mut lib_imports = Vec::new();
+    let mut full = Vec::new();
+    for entry in guest.imports() {
+        let ExternType::Func(f) = entry.ty() else {
+            anyhow::bail!("non-function import")
+        };
+        let import = Import::new(
+            entry.module(),
+            entry.name(),
+            f.params().map(kind).collect::<Result<Vec<_>>>()?,
+            f.results().map(kind).collect::<Result<Vec<_>>>()?,
+        );
+        if entry.module() == "wasmc:private/canonical-memory@1"
+            || entry.module() == "wasmc:lib/wasmc-json@0.2.1"
+        {
+            lib_imports.push(import.clone());
+        } else {
+            ensure!(
+                mcpgit_guest_contract::find(entry.module(), entry.name()).is_some(),
+                "unknown Host import"
+            );
+        }
+        full.push(import);
+    }
+    ensure!(
+        lib_imports.len() == 59 && full.len() == 62,
+        "unexpected mixed imports"
+    );
+    let plan = CoreLibCallPlan::new(provider.clone(), lib_imports)?;
+    let runtime = CoreDomainRuntime::default();
+    let artifact = runtime.prepare_scalar_host(wasm, [96; 32], &full)?;
+    const PAGE: usize = 65536;
+    for has_other_budget in [false, true] {
+        let provider_budget = wasmc_core_runtime::CoreSharedMemoryBudget::new(128 * PAGE);
+        let other_budget = wasmc_core_runtime::CoreSharedMemoryBudget::new(128 * PAGE);
+        let instance = plan.instantiate_with_memory_budget(&provider_budget)?;
+        let expected = instance.instance();
+        let mut session = CoreDomainScalarHostSession::new(instance);
+        if has_other_budget {
+            session = session.with_memory_budget(other_budget.clone());
+        }
+        let result =
+            plan.bind_budgeted_import(session, &plan.imports()[0], expected, |state| state);
+        ensure!(
+            result.is_err(),
+            "provider and Guest budgets differed or were absent"
+        );
+        ensure!(
+            provider_budget.reserved_bytes() == 0 && other_budget.reserved_bytes() == 0,
+            "mismatched budget retained memory"
+        );
+    }
+    let insufficient_provider = wasmc_core_runtime::CoreSharedMemoryBudget::new(16 * PAGE);
+    ensure!(
+        plan.instantiate_with_memory_budget(&insufficient_provider)
+            .is_err(),
+        "JSON provider exceeded initial budget"
+    );
+    ensure!(
+        insufficient_provider.reserved_bytes() == 0,
+        "failed JSON provider instantiation leaked memory"
+    );
+    for round in 0..6 {
+        if round == 3 {
+            ensure!(
+                runtime.request_optimization(&artifact)?,
+                "optimization request rejected"
+            );
+            ensure!(
+                artifact
+                    .wait_for_optimization(std::time::Duration::from_secs(30))
+                    .state
+                    == crate::core_runtime::CoreDomainState::Candidate,
+                "Wasmtime candidate unavailable"
+            );
+            ensure!(
+                artifact.publish_optimization(true, true, u64::MAX, 0)?,
+                "candidate promotion rejected"
+            );
+        }
+        let budget = wasmc_core_runtime::CoreSharedMemoryBudget::new(if round % 3 == 0 {
+            33 * PAGE
+        } else {
+            128 * PAGE
+        });
+        let instance = if round % 3 == 1 {
+            other_provider_fixture()?.instantiate_fresh_with_memory_budget(&budget)?
+        } else {
+            plan.instantiate_with_memory_budget(&budget)?
+        };
+        if round % 3 != 1 {
+            ensure!(
+                budget.reserved_bytes() == 17 * PAGE,
+                "unexpected JSON provider initial memory"
+            );
+        }
+        let expected = instance.instance();
+        let limits = ProgrammableQueryLimits::default();
+        let store_limits = StoreLimitsBuilder::new()
+            .memory_size(limits.max_memory_bytes)
+            .instances(1)
+            .memories(1)
+            .tables(1)
+            .build();
+        let pool = crate::route_wasm_executor::empty_query_pool("mixed-fixture", 1)?;
+        let host = QueryHost::new_with_table_mutations(
+            pool.checkout("mixed-fixture")?,
+            limits,
+            store_limits,
+            Extension { lib: instance },
+            Some(table_provider.clone()),
+        );
+        let mut session = CoreDomainScalarHostSession::new(host).with_memory_budget(budget.clone());
+        for import in &full {
+            if import.module() == "wasmc:private/canonical-memory@1"
+                || import.module() == "wasmc:lib/wasmc-json@0.2.1"
+            {
+                session = plan.bind_budgeted_import(session, import, expected, |host| {
+                    &mut host.extension_mut::<Extension>().expect("extension").lib
+                })?;
+            } else {
+                let function = *mcpgit_guest_contract::find(import.module(), import.name())
+                    .expect("checked Host import");
+                session = mcpgit_programmable_query_runtime::bind_programmable_wit_core(
+                    session, function,
+                )?;
+            }
+        }
+        let mut outcome = artifact.invoke_scalar_with_session_state(session, "run", &[]);
+        if round % 3 == 1 {
+            let error = outcome
+                .invocation
+                .expect_err("foreign budgeted provider accepted");
+            ensure!(
+                error
+                    .to_string()
+                    .contains("Core Lib session provider changed"),
+                "wrong identity failure: {error}"
+            );
+            ensure!(
+                outcome.state.live_handles() == 0,
+                "foreign provider leaked Host handles"
+            );
+            drop(outcome.state);
+            ensure!(
+                budget.reserved_bytes() == 0,
+                "foreign provider reservation leaked"
+            );
+            println!(
+                "BUDGETED_FOREIGN_REJECTED backend={}",
+                if round < 3 { "Wasmi" } else { "Wasmtime" }
+            );
+            continue;
+        }
+        if round % 3 == 0 {
+            ensure!(
+                outcome.invocation.is_err(),
+                "combined Guest and JSON provider memory bypassed the budget"
+            );
+            ensure!(
+                budget.reserved_bytes() == 17 * PAGE,
+                "failed Guest instantiation retained memory"
+            );
+            drop(outcome.state);
+            ensure!(
+                budget.reserved_bytes() == 0,
+                "provider memory retained after failed invocation"
+            );
+            println!(
+                "BUDGET_REJECTED backend={}",
+                if round < 3 { "Wasmi" } else { "Wasmtime" }
+            );
+            continue;
+        }
+        let result = outcome.invocation.map_err(|e| anyhow::anyhow!("{e}"))?;
+        ensure!(
+            result.backend
+                == if round < 3 {
+                    crate::core_runtime::CoreDomainBackend::Wasmi
+                } else {
+                    crate::core_runtime::CoreDomainBackend::Wasmtime
+                },
+            "unexpected backend"
+        );
+        ensure!(
+            result.values == [Scalar::I32(26)]
+                && outcome.state.live_handles() == 0
+                && outcome.state.host_calls() == 2,
+            "budgeted mixed execution mismatch"
+        );
+        let provider = &mut outcome
+            .state
+            .extension_mut::<Extension>()
+            .expect("extension")
+            .lib;
+        let instance = provider.instance();
+        let memory = instance
+            .get_memory(provider.store_mut(), "memory")
+            .expect("JSON memory");
+        let provider_bytes = memory.data_size(provider.store_mut());
+        ensure!(
+            budget.reserved_bytes() == provider_bytes,
+            "Guest memory retained or provider not accounted"
+        );
+        drop(outcome.state);
+        ensure!(
+            budget.reserved_bytes() == 0,
+            "provider memory retained after successful invocation"
+        );
+        println!(
+            "BUDGETED_JSON_HOST_OK operations=26 backend={:?}",
+            result.backend
+        );
+    }
+    Ok(())
+}
