+/// Fresh provider whose linear memory participates in a Host-owned invocation budget.
+pub struct BudgetedCoreLibInstance {
+    budget: wasmc_core_runtime::CoreSharedMemoryBudget,
+    store: Store<BudgetedCoreLibStore>,
+    instance: Instance,
+    package_id: String,
+    version: String,
+    artifact_sha256: String,
+}
+
+pub(crate) struct BudgetedCoreLibStore {
+    reservation: wasmc_core_runtime::CoreSharedMemoryReservation,
+}
+impl wasmtime::ResourceLimiter for BudgetedCoreLibStore {
+    fn memory_growing(
+        &mut self,
+        current: usize,
+        desired: usize,
+        maximum: Option<usize>,
+    ) -> wasmtime::Result<bool> {
+        if maximum.is_some_and(|max| desired > max) {
+            return Ok(false);
+        }
+        Ok(self.reservation.try_grow(current, desired))
+    }
+    fn memory_grow_failed(&mut self, _error: wasmtime::Error) -> wasmtime::Result<()> {
+        self.reservation.growth_failed();
+        Ok(())
+    }
+    fn table_growing(
+        &mut self,
+        _current: usize,
+        desired: usize,
+        maximum: Option<usize>,
+    ) -> wasmtime::Result<bool> {
+        Ok(maximum.is_none_or(|max| desired <= max))
+    }
+    fn instances(&self) -> usize {
+        usize::MAX
+    }
+    fn tables(&self) -> usize {
+        usize::MAX
+    }
+    fn memories(&self) -> usize {
+        usize::MAX
+    }
