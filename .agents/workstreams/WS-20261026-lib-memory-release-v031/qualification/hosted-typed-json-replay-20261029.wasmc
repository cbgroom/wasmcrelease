package conformance:checked;
interface api {
 record boolean_value {present:bool,value:bool}
 record json_field {name:string,value_json:string}
 enum edit_kind {set,remove}
 record edit {kind:edit_kind,path:string,value_json:string}
 enum json_error {invalid_json,invalid_pointer,missing_target,type_mismatch,invalid_index,out_of_range,invalid_operation,allocation_failed}
 record query_pair {name:string,value:string}
 record header {name:string,value:list<u8>}
 record request {method:string,path:string,parameters:list<query_pair>,query:list<query_pair>,headers:list<header>,body:list<u8>}
 record response {status:u16,body:list<u8>}
 record insert_operation {operation_id:string,key:string,row_json:string}
 record set_field {field:string,value_json:string}
 record patch_field {field:string,patch:string,expected_value_sha256:option<string>}
 record update_operation {operation_id:string,key:string,expected_row_version:u64,field_updates:list<variant {set(set_field),unset(string),apply_patch(patch_field)}>}
 record delete_operation {operation_id:string,key:string,expected_row_version:u64}
 record transaction {table_path:string,expected_revision:string,transaction_id:string,idempotency_key:option<string>,operations:list<variant {insert(insert_operation),update(update_operation),delete(delete_operation)}>}
 run:func(req:request)->response {
  let payload:string = document::compact_or_bytes(req.body,"{}");
  let many_result:result<boolean_value,json_error> = document::read_bool(utf8::encode(payload),"/many");
  let invalid_result:result<boolean_value,json_error> = document::read_bool(utf8::encode(payload),"/invalid");
  let many:bool = match many_result {ok(value)=>value.present && value.value,err=>false};
  let invalid:bool = match invalid_result {ok(value)=>value.present && value.value,err=>false};
  let mut array_count:u32 = 1;
  if (many) { array_count=300; }
  let mut parts:list<string> = list.new();
  let mut index:u32 = 0;
  while (index < array_count) {
   if (invalid) {parts.push("not-json");} else {parts.push("123");}
   index=index+1;
  }
  let array_text:string = document::array_from_values_or(parts,"[]");
  let mut fields:list<json_field> = list.new();
  fields.push({name:"items",value_json:array_text});
  fields.push({name:"name",value_json:document::quote_string("雪")});
  let object_text:string = document::object_from_fields_or(fields,"{}");
  let key:string = document::select_string_or_bytes(utf8::encode(payload),"/operations/0/key","");
  let op_id:string = document::select_string_or_bytes(utf8::encode(payload),"/operations/0/operation_id","");
  let duplicate_id:string = document::select_string_or_bytes(utf8::encode(payload),"/operations/1/operation_id","");
  let revision:string = document::select_string_or_bytes(utf8::encode(payload),"/expected_revision","");
  let tx_id:string = document::select_string_or_bytes(utf8::encode(payload),"/transaction_id","");
  let mut row_fields:list<json_field> = list.new();
  row_fields.push({name:"id",value_json:document::quote_string(document::select_string_or_bytes(utf8::encode(payload),"/operations/0/key",""))});
  row_fields.push({name:"value",value_json:object_text});
  row_fields.push({name:"processed",value_json:"true"});
  row_fields.push({name:"sequence",value_json:"42"});
  let row_text:string = document::object_from_fields_or(row_fields,"{}");
  let mut operations:list<variant {insert(insert_operation),update(update_operation),delete(delete_operation)}> = list.new();
  let action:variant {insert(insert_operation),update(update_operation),delete(delete_operation)} = variant.insert({operation_id:op_id,key:key,row_json:row_text});
  operations.push(action);
  let second_key:string = document::select_string_or_bytes(utf8::encode(payload),"/operations/1/key","");
  let mut second_fields:list<json_field> = list.new();
  second_fields.push({name:"id",value_json:document::quote_string(document::select_string_or_bytes(utf8::encode(payload),"/operations/1/key",""))});
  second_fields.push({name:"value",value_json:"{}"});
  second_fields.push({name:"processed",value_json:"false"});
  second_fields.push({name:"sequence",value_json:"0"});
  let second_row:string = document::object_from_fields_or(second_fields,"{}");
  let duplicate_action:variant {insert(insert_operation),update(update_operation),delete(delete_operation)} = variant.insert({operation_id:duplicate_id,key:second_key,row_json:second_row});
  operations.push(duplicate_action);
  let called:result<unit,variant {invalid_argument(string),permission_denied(string),stale_revision(string),transaction_rejected(string),budget_exceeded(string)}> = table::transact_discarded({table_path:"json_results",expected_revision:revision,transaction_id:tx_id,idempotency_key:some(document::select_string_or_bytes(utf8::encode(payload),"/idempotency_key","")),operations:operations});
  let status:u16 = match called {ok=>201,err=>409};
  let body:list<u8> = utf8::encode(payload);
  return {status:status,body:body};
 }
} world app {export api;}