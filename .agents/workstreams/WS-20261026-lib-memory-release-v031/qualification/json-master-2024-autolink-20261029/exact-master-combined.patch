+        for (o, t) in &offsets {
+            args.extend(g.load(**t, &format!("add(args.p,{})", o.size_wasm32()), 0)?);
+        }
+        source += &format!("let result=raw{i}({});", args.join(","));
+        if let Some(t) = f.result {
+            let size = g.s.size(&t).size_wasm32();
+            let align = g.s.align(&t).align_wasm32();
+            if exported.retptr {
+                let target = imported.params.len() - 1;
+                source+=&format!("let dst=p{target} as u32;range(false,dst,{size},{align});zero(false,dst,{size});{}(result as u32,dst,true,false,&mut b);",Gen::name(t));
+                if has_post {
+                    source += &format!("post{i}(result as i32);");
+                }
+            } else if !exported.results.is_empty() {
+                source += &format!("let out=Scratch::new({size},{align},&mut b);");
+                source += &g.store(t, "out.p", &[("result".into(), exported.results[0])], 0)?;
+                source += &format!("{}(out.p,out.p,false,false,&mut b);", Gen::name(t));
+                if has_post {
+                    source += &format!("post{i}(result as i32);");
+                }
+                let values = g.load(t, "out.p", 0)?;
+                source += &values[0];
+            }
+        }
+        source += "}\n";
+        let value_window = if value_windows {
+            let bounded=|n:usize|u32::try_from(n).map_err(|_|fail("value window layout exceeds wasm32"));
+            let parameter_bytes=bounded(layout.size.size_wasm32())?;
+            let parameter_alignment=bounded(layout.align.align_wasm32())?;
+            let result_bytes=bounded(f.result.map_or(0,|t|g.s.size(&t).size_wasm32()))?;
+            let result_alignment=bounded(f.result.map_or(1,|t|g.s.align(&t).align_wasm32()))?;
+            if parameter_bytes>16*1024*1024||result_bytes>16*1024*1024{return Err(fail("value window byte budget"));}
+            let call_export=format!("__wasmc_value_call_{i}");
+            let post_export=format!("__wasmc_value_post_{i}");
+            let open_export=format!("__wasmc_value_open_{i}");
+            let cancel_export=format!("__wasmc_value_cancel_{i}");
+            let mut arguments=Vec::new();
+            for (o,t) in &offsets { arguments.extend(g.load(**t,&format!("add(p,{})",o.size_wasm32()),0)?); }
+            if imported.retptr { arguments.push("d as i32".into()); }
+            source+=&format!("#[no_mangle]pub unsafe extern \"C\" fn {open_export}()->u64{{value_open({i},{parameter_bytes},{parameter_alignment},{result_bytes},{result_alignment})}}\n#[no_mangle]pub unsafe extern \"C\" fn {cancel_export}(d:u32){{value_cancel({i},d);}}\n");
+            source+=&format!("#[no_mangle]pub unsafe extern \"C\" fn {call_export}(p:u32,d:u32){{range(false,p,{parameter_bytes},{parameter_alignment});range(false,d,{result_bytes},{result_alignment});assert!(add(p,{parameter_bytes})<=d||add(d,{result_bytes})<=p);value_call_begin({i},p,d);let result={PREFIX}{i}({});",arguments.join(","));
+            if !imported.retptr {
+                if let (Some(t),Some(lane))=(f.result,imported.results.first()) {
+                    source+=&g.store(t,"d",&[("result".into(),*lane)],0)?;
+                }
+            }
+            source+="value_ready();}\n";
+            source+=&format!("#[no_mangle]pub unsafe extern \"C\" fn {post_export}(d:u32){{value_post({i},d);}}\n");
+            Some(CanonicalValueOperation { interface:iface.clone().unwrap_or_else(||"$root".into()),
+                operation:f.name.clone(),call_export,post_export,open_export,cancel_export,parameter_bytes,parameter_alignment,result_bytes,result_alignment })
+        } else {None};
+        bindings.push(Binding {
+            module: iface.unwrap_or_else(|| "$root".into()),
+            name: f.name.clone(),
+            export: format!("{PREFIX}{i}"),
+            signature: (
+                imported.params.into_iter().map(wasm32).collect(),
+                imported.results.into_iter().map(wasm32).collect(),
+            ),
+            value_window,
+        });
+    }
+    source += "}\n";
+    if source.len() > MAX_SOURCE {
+        return Err(fail("generated source budget"));
+    }
+    Ok((CanonicalCoreBridge { source }, bindings))
+}
