+pub fn generate_rust_wit_canonical_core_bridge(
+    artifact: &[u8],
+    ap: &str,
+    wit: &[u8],
+    wp: &str,
+    module: &str,
+) -> Result<CanonicalCoreBridge, LibToolRustConsumerSdkError> {
+    Ok(build(artifact, ap, wit, wp, module)?.0)
+}
+
+/// Generate per-Lib private value calls and exact-once result leases. App
+/// compilation consumes only the compiled bridge and data-only WIT layouts.
+/// Every successful call requires its matching post after copying its result;
+/// a trap terminates the Store. Default SDK generation remains byte-identical.
+pub fn generate_rust_wit_canonical_value_core_bridge(
+    artifact:&[u8],ap:&str,wit:&[u8],wp:&str,module:&str,
+) -> Result<CanonicalValueCoreBridge,LibToolRustConsumerSdkError> {
+    let (bridge,bindings)=build_with_value_windows(artifact,ap,wit,wp,module,true)?;
+    Ok(CanonicalValueCoreBridge {source:bridge.source,
+        operations:bindings.into_iter().map(|b|b.value_window.expect("value window generation selected")).collect()})
+}
+
+struct Redirect {
+    imported: u32,
+    retained: u32,
+    mapping: Vec<u32>,
+    removed: BTreeMap<(String, String), u32>,
+    hidden: Vec<String>,
+}
+impl Reencode for Redirect {
+    type Error = String;
+    fn function_index(&mut self, i: u32) -> u32 {
+        if i < self.imported {
+            self.mapping[i as usize]
+        } else {
+            self.retained + i - self.imported
+        }
+    }
+    fn parse_import_section(
+        &mut self,
+        s: &mut ImportSection,
+        r: wasmparser::ImportSectionReader<'_>,
+    ) -> Result<(), reencode::Error<Self::Error>> {
+        for i in r {
+            let i = i?;
+            if !self
+                .removed
+                .contains_key(&(i.module.to_owned(), i.name.to_owned()))
+            {
+                self.parse_import(s, i)?;
+            }
+        }
+        Ok(())
+    }
+    fn parse_export_section(
+        &mut self,
+        s: &mut ExportSection,
+        r: wasmparser::ExportSectionReader<'_>,
+    ) -> Result<(), reencode::Error<Self::Error>> {
+        for e in r {
+            let e = e?;
+            if !self.hidden.iter().any(|n| n == e.name) {
+                self.parse_export(s, e);
+            }
+        }
+        Ok(())
+    }
+}
+/// Replace official guest-import calls with exact private compiled shims, then
+/// lower all memory intrinsics. Original Lib and public WIT remain unchanged.
+pub fn prepare_rust_wit_canonical_sdk_caller(
+    caller: &[u8],
+    artifact: &[u8],
+    ap: &str,
+    wit: &[u8],
+    wp: &str,
+    module: &str,
+) -> Result<Vec<u8>, LibToolRustConsumerSdkError> {
+    if caller.len() > 4 * 1024 * 1024 {
+        return Err(fail("caller byte budget"));
+    }
+    let (_, bindings) = build(artifact, ap, wit, wp, module)?;
+    wasmparser::Validator::new()
+        .validate_all(caller)
+        .map_err(|e| fail(e.to_string()))?;
+    let mut types = Vec::new();
+    let mut imports = Vec::new();
+    let mut functions = Vec::new();
+    let mut exports = BTreeMap::new();
+    for p in Parser::new(0).parse_all(caller) {
+        match p.map_err(|e| fail(e.to_string()))? {
+            Payload::TypeSection(s) => {
+                for t in s.into_iter_err_on_gc_types() {
+                    let t = t.map_err(|e| fail(e.to_string()))?;
+                    types.push((t.params().to_vec(), t.results().to_vec()));
+                }
+            }
+            Payload::ImportSection(s) => {
+                for i in s {
+                    let i = i.map_err(|e| fail(e.to_string()))?;
+                    let TypeRef::Func(t) = i.ty else {
+                        return Err(fail("caller initially imports functions only"));
+                    };
+                    imports.push((i.module.to_owned(), i.name.to_owned(), t));
+                }
+            }
+            Payload::FunctionSection(s) => {
+                for t in s {
+                    functions.push(t.map_err(|e| fail(e.to_string()))?);
+                }
+            }
+            Payload::ExportSection(s) => {
+                for e in s {
+                    let e = e.map_err(|e| fail(e.to_string()))?;
+                    if e.kind == wasmparser::ExternalKind::Func {
+                        exports.insert(e.name.to_owned(), e.index);
+                    }
+                }
+            }
+            _ => {}
+        }
+    }
+    if imports.len() > 1024 {
+        return Err(fail("original import budget"));
+    }
+    let mut seen = BTreeSet::new();
+    for (m, n, _) in &imports {
+        if !seen.insert((m, n)) {
+            return Err(fail("duplicate original import"));
+        }
+    }
+    let mut removed = BTreeMap::new();
+    let mut hidden = Vec::new();
+    for b in bindings {
+        let Some(&index) = exports.get(&b.export) else {
+            continue;
+        };
+        if index < (imports.len() as u32) {
+            return Err(fail("bridge must be caller-local"));
+        }
+        let ty = functions
+            .get(index as usize - imports.len())
+            .ok_or_else(|| fail("bridge function index"))?;
+        if types.get(*ty as usize) != Some(&b.signature) {
+            return Err(fail("bridge signature drift"));
+        }
+        removed.insert((b.module, b.name), index);
+        hidden.push(b.export);
+    }
+    let mut retained = 0;
+    for (m, n, t) in &imports {
+        if let Some(&index) = removed.get(&(m.clone(), n.clone())) {
+            let _ = index;
+            let b = hidden
+                .iter()
+                .find(|x| exports.get(*x) == Some(&index))
+                .unwrap();
+            let own_ty = functions[index as usize - imports.len()];
+            if types.get(*t as usize) != types.get(own_ty as usize) {
+                return Err(fail(format!("official SDK import differs from {b}")));
+            }
+        } else {
+            retained += 1;
+        }
+    }
+    let mapping = imports
+        .iter()
+        .map(|(m, n, _)| {
+            if let Some(i) = removed.get(&(m.clone(), n.clone())) {
+                retained + *i - imports.len() as u32
+            } else {
+                0
+            }
+        })
+        .collect::<Vec<_>>();
+    let mut mapping = mapping;
+    let mut next = 0;
+    let mut actual = 0;
+    for (i, (m, n, _)) in imports.iter().enumerate() {
+        if !removed.contains_key(&(m.clone(), n.clone())) {
+            mapping[i] = next;
+            next += 1;
+        } else {
+            actual += 1;
+        }
+    }
+    if actual == 0 {
+        return Err(fail("no actual SDK call import"));
+    }
+    let mut re = Redirect {
+        imported: imports.len() as u32,
+        retained,
+        mapping,
+        removed,
+        hidden,
+    };
+    let mut out = Module::new();
+    re.parse_core_module(&mut out, Parser::new(0), caller)
+        .map_err(|e| fail(e.to_string()))?;
+    prepare_rust_wit_canonical_core_caller(&out.finish(), artifact, ap, wit, wp, module)
+}
