+//! Generated transfer shims around the official guest-import SDK.
+//! Layout/signatures come from WIT, never Rust layout or package/API names.
+use super::{
+    canonical_memory::{pinned_inventory, wasm32},
+    invalid, prepare_rust_wit_canonical_core_caller, LibToolRustConsumerSdkError,
+};
+use crate::self_bundle::{hex, sha256};
+use std::collections::{BTreeMap, BTreeSet};
+use wasm_encoder::{
+    reencode::{self, Reencode},
+    ExportSection, ImportSection, Module,
+};
+use wasmparser::{Parser, Payload, TypeRef};
+use wit_parser::{
+    abi::{AbiVariant, FlatTypes, WasmType},
+    FlagsRepr, Int, Resolve, SizeAlign, Type, TypeDefKind, WorldItem,
+};
+
+const PREFIX: &str = "__wasmc_canonical_bridge_";
+const MAX_SOURCE: usize = 2 * 1024 * 1024;
+type Sig = (Vec<wasmparser::ValType>, Vec<wasmparser::ValType>);
+#[derive(Debug, Clone)]
+pub struct CanonicalCoreBridge {
+    pub source: String,
+}
+/// Native, compiler-private packed value entrypoints. Not an Agent/public ABI.
+#[derive(Debug, Clone)]
+pub struct CanonicalValueCoreBridge {
+    pub source: String,
+    pub operations: Vec<CanonicalValueOperation>,
+}
+#[derive(Debug, Clone)]
+pub struct CanonicalValueOperation {
+    pub interface: String,
+    pub operation: String,
+    pub call_export: String,
+    pub post_export: String,
+    pub open_export: String,
+    pub cancel_export: String,
+    pub parameter_bytes: u32,
+    pub parameter_alignment: u32,
+    pub result_bytes: u32,
+    pub result_alignment: u32,
+}
+struct Binding {
+    module: String,
+    name: String,
+    export: String,
+    signature: Sig,
+    value_window: Option<CanonicalValueOperation>,
+}
+struct Gen<'a> {
+    r: &'a Resolve,
+    s: SizeAlign,
+    weights: BTreeMap<wit_parser::TypeId, u32>,
+    // Preserve published Core SDK bytes; optimize only value-window transfer.
+    bulk_string_gather: bool,
+}
+fn fail(s: impl Into<String>) -> LibToolRustConsumerSdkError {
+    invalid(format!("Canonical SDK bridge: {}", s.into()))
+}
+fn rust(t: WasmType) -> &'static str {
+    match t {
+        WasmType::I32 | WasmType::Pointer | WasmType::Length => "i32",
+        WasmType::I64 | WasmType::PointerOrI64 => "i64",
+        WasmType::F32 => "f32",
+        WasmType::F64 => "f64",
+    }
+}
+fn cast(e: &str, from: WasmType, to: WasmType) -> String {
+    let a = rust(from);
+    let b = rust(to);
+    if a == b {
+        return e.into();
+    }
+    let bits = match a {
+        "f32" => format!("({e}).to_bits()"),
+        "f64" => format!("({e}).to_bits()"),
+        _ => format!("({e})"),
+    };
+    match b {
+        "f32" => format!("f32::from_bits({bits} as u32)"),
+        "f64" => format!("f64::from_bits({bits} as u64)"),
+        _ => format!("({bits} as {b})"),
+    }
+}
+fn tag_size(tag: Int) -> usize {
+    match tag {
+        Int::U8 => 1,
+        Int::U16 => 2,
+        Int::U32 => 4,
+        Int::U64 => 8,
+    }
+}
+impl Gen<'_> {
+    fn depth(&self, t: Type, n: usize) -> Result<bool, LibToolRustConsumerSdkError> {
+        if n >= 32 {
+            return Err(fail("complete value type depth budget"));
+        }
+        let nested = match t {
+            Type::String => return Ok(true),
+            Type::Id(id) => match &self.r.types[id].kind {
+                TypeDefKind::Type(t)
+                | TypeDefKind::Option(t)
+                | TypeDefKind::FixedLengthList(t, _) => vec![*t],
+                TypeDefKind::List(t) => {
+                    self.depth(*t, n + 1)?;
+                    return Ok(true);
+                }
+                TypeDefKind::Record(r) => r.fields.iter().map(|f| f.ty).collect(),
+                TypeDefKind::Tuple(r) => r.types.clone(),
+                TypeDefKind::Variant(v) => v.cases.iter().filter_map(|c| c.ty).collect(),
+                TypeDefKind::Result(r) => r.ok.into_iter().chain(r.err).collect(),
+                TypeDefKind::Enum(_) | TypeDefKind::Flags(_) => vec![],
+                _ => return Err(fail("unsupported complete value type")),
+            },
+            Type::ErrorContext => return Err(fail("error-context")),
+            _ => vec![],
