package conformance:paired_response; interface api {handle:func()->u32 {let header:result<unit,u32> = exchange::append_response_header("x-reply",utf8::encode("b")); let h:u32 = match header {ok=>1,err=>0}; if(h==0){return 500;} let status:result<unit,u32> = exchange::set_response_status(206); let s:u32 = match status {ok=>1,err=>0}; if(s==0){return 500;} let mut bytes:list<u8> = list.new(); bytes.push(0); bytes.push(255); bytes.push(128); let body:result<unit,u32> = exchange::set_response_body(bytes); let b:u32 = match body {ok=>1,err=>0}; if(b==0){return 500;} let c:result<unit,u32> = exchange::set_control(1); return match c {ok=>200,err=>500};}} world app {export api;}