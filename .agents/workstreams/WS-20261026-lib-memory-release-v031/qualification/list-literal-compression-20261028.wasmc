package local:compression_q2; interface api { enum compression_error { input_too_large, output_too_large, invalid_stream, internal_failure } run:func()->result<list<u8>,compression_error> { return gzip::decompress([31,139,8,0,0,0,0,0,2,255,99,96,172,111,248,207,224,232,4,0,82,131,114,39,8,0,0,0]); } bad:func()->result<list<u8>,compression_error> {return gzip::decompress([0,1,2]);} } world app {export api;}
