package local:json_record_literal; interface api { enum json_error { invalid_json, invalid_pointer, missing_target, type_mismatch, invalid_index, out_of_range, invalid_operation, allocation_failed } record json_field {name:string,value_json:string} run:func()->result<string,json_error> {return document::object_from_fields([{name:"x",value_json:"1"},{name:"雪",value_json:"true"}]);} bad:func()->result<string,json_error> {return document::object_from_fields([{name:"x",value_json:"bad"}]);} } world app {export api;}
