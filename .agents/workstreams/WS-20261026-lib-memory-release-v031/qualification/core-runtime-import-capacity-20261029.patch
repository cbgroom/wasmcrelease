+#[test]
+fn host_plans_scale_beyond_legacy_import_counts_on_both_engines() {
+    let count=130usize;
+    let mut source=String::from("(module ");
+    for i in 0..count { source.push_str(&format!("(import \"host\" \"f{i}\" (func $f{i} (result i32))) ")); }
+    source.push_str("(func (export \"run\") (result i32) i32.const 0 ");
+    for i in 0..count { source.push_str(&format!("call $f{i} i32.add ")); }
+    source.push_str("))");
+    let wasm=wat::parse_str(source).unwrap();
+    let imports=(0..count).map(|i|CoreScalarHostImport::new("host",format!("f{i}"),vec![],vec![CoreScalarType::I32])).collect::<Vec<_>>();
+    let sdk=CoreRuntimeSdk::new(CoreRuntimeSdkConfig::new(4,1)).unwrap();
+    let artifact=sdk.prepare_scalar_host_core(&wasm,policy(80),&imports).unwrap();
+    let session=|| {let mut s=CoreScalarHostSession::new(0usize);for (i,import) in imports.iter().cloned().enumerate() {s=s.bind(import,move |state,_,args|{assert!(args.is_empty());*state+=1;Ok(vec![CoreScalarValue::I32(i as i32)])});}s};
+    let expected=(0..count as i32).sum::<i32>();
+    let first=artifact.invoke_scalar_with_session(session(),"run",&[]).unwrap();
+    assert_eq!(first.backend,CoreRuntimeBackend::Wasmi);assert_eq!(first.values,[CoreScalarValue::I32(expected)]);
+    promote(&sdk,&artifact);
+    let second=artifact.invoke_scalar_with_session(session(),"run",&[]).unwrap();
+    assert_eq!(second.backend,CoreRuntimeBackend::Wasmtime);assert_eq!(second.values,first.values);
+}
+
+#[test]
+fn scalar_host_values_scale_past_sixteen_on_both_engines() {
+    let count=24usize;
+    let types="i32 ".repeat(count);
+    let mut source=format!("(module (import \"host\" \"wide\" (func $wide (param {types})(result {types}))) (func (export \"run\") (param {types})(result {types}) ");
+    for i in 0..count { source.push_str(&format!("local.get {i} ")); }
+    source.push_str("call $wide))");
+    let wasm=wat::parse_str(source).unwrap();
+    let import=CoreScalarHostImport::new("host","wide",vec![CoreScalarType::I32;count],vec![CoreScalarType::I32;count]);
+    let sdk=CoreRuntimeSdk::new(CoreRuntimeSdkConfig::new(4,1)).unwrap();
+    let artifact=sdk.prepare_scalar_host_core(&wasm,policy(81),std::slice::from_ref(&import)).unwrap();
+    let session=||CoreScalarHostSession::new(()).bind(import.clone(),|_,_,args|Ok(args.to_vec()));
+    let args=(0..count).map(|v|CoreScalarValue::I32(v as i32)).collect::<Vec<_>>();
+    let first=artifact.invoke_scalar_with_session(session(),"run",&args).unwrap();assert_eq!(first.backend,CoreRuntimeBackend::Wasmi);assert_eq!(first.values,args);
+    promote(&sdk,&artifact);
+    let second=artifact.invoke_scalar_with_session(session(),"run",&args).unwrap();assert_eq!(second.backend,CoreRuntimeBackend::Wasmtime);assert_eq!(second.values,first.values);
+}
