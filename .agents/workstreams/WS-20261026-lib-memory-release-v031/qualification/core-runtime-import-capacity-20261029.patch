+#[test]
+fn i32_host_plans_scale_past_thirty_two_on_both_engines() {
+    let count=130usize;
+    let mut source=String::from("(module ");
+    for i in 0..count { source.push_str(&format!("(import \"host\" \"f{i}\" (func $f{i} (result i32))) ")); }
+    source.push_str("(func (export \"run\") (result i32) i32.const 0 ");
+    for i in 0..count { source.push_str(&format!("call $f{i} i32.add ")); }
+    source.push_str("))");
+    let wasm=wat::parse_str(source).unwrap();
+    let imports=(0..count).map(|i|I32LaneHostImport::new("host",format!("f{i}"),0)).collect::<Vec<_>>();
+    let sdk=CoreRuntimeSdk::new(CoreRuntimeSdkConfig::new(4,1)).unwrap();
+    let artifact=sdk.prepare_i32_lane_host_core(&wasm,policy(82),&imports).unwrap();
+    let bindings=|| imports.iter().cloned().enumerate().map(|(i,import)|I32LaneHostBinding::new(import,move |_,args|{assert!(args.is_empty());Ok(i as i32)})).collect::<Vec<_>>();
+    let expected=(0..count as i32).sum::<i32>();
+    let first=artifact.invoke_i32_lane_with_host(bindings(),"run",&[]).unwrap();assert_eq!(first.backend,CoreRuntimeBackend::Wasmi);assert_eq!(first.value,expected);
+    promote(&sdk,&artifact);
+    let second=artifact.invoke_i32_lane_with_host(bindings(),"run",&[]).unwrap();assert_eq!(second.backend,CoreRuntimeBackend::Wasmtime);assert_eq!(second.value,first.value);
+}
