+// Bind the WIT declarations to this SDK's own canonical adapters at generation
+// time. Require a bijection so a generator layout change fails rather than
+// silently producing a SDK whose methods call the wrong operation.
+fn link_generated_canonical_sdk(source: &str) -> Result<String, LibToolRustConsumerSdkError> {
+    use std::collections::{BTreeMap, BTreeSet};
+    let mut bridges = BTreeMap::<String, String>::new();
+    let mut remaining = source;
+    let marker = "#[link_name=\"";
+    while let Some(offset) = remaining.find(marker) {
+        remaining = &remaining[offset + marker.len()..];
+        let Some(end) = remaining.find("\"]") else { break };
+        let name = &remaining[..end];
+        let suffix = &remaining[end + 2..];
+        let Some(after) = suffix.strip_prefix("fn raw") else { remaining = suffix; continue };
+        let digits = after.bytes().take_while(u8::is_ascii_digit).count();
+        if name.contains('#') && digits > 0 && after.as_bytes().get(digits) == Some(&b'(') {
+            if bridges.insert(name.to_owned(), after[..digits].to_owned()).is_some() {
+                return Err(invalid("duplicate generated canonical bridge"));
+            }
+        }
+        remaining = after;
+    }
+    if bridges.is_empty() { return Err(invalid("missing generated canonical bridges")); }
+    let mut result = source.to_owned();
+    let mut seen = BTreeSet::new();
+    for (key, index) in &bridges {
+        let (interface, operation) = key.rsplit_once('#').ok_or_else(|| invalid("invalid generated canonical bridge"))?;
+        let attribute = format!("#[link(wasm_import_module = {interface:?})]");
+        let operation_attr = format!("#[link_name = {operation:?}]");
+        let start = result.find(&attribute).ok_or_else(|| invalid("missing generated WIT import"))?;
+        let tail = &result[start + attribute.len()..];
+        let end = tail.find('}').ok_or_else(|| invalid("invalid generated WIT import block"))?;
+        let block = &tail[..end];
+        if !block.contains("unsafe extern \"C\"") || !block.contains(&operation_attr) {
+            // More than one operation can share an interface. Search the block
+            // associated with the exact attribute, not an arbitrary interface.
+            let mut cursor = start;
+            let mut selected = None;
+            while let Some(relative) = result[cursor..].find(&attribute) {
+                let at = cursor + relative;
+                let following = &result[at + attribute.len()..];
+                let close = following.find('}').ok_or_else(|| invalid("invalid generated WIT import block"))?;
+                if following[..close].contains(&operation_attr) { selected = Some(at); break; }
+                cursor = at + attribute.len();
+            }
+            let at = selected.ok_or_else(|| invalid("missing generated WIT operation"))?;
+            let attr_end = at + attribute.len();
+            let op_at = attr_end + result[attr_end..].find(&operation_attr).ok_or_else(|| invalid("missing operation attribute"))?;
+            result.replace_range(op_at..op_at + operation_attr.len(), &format!("#[link_name = \"__wasmc_canonical_bridge_{index}\"]"));
+            result.replace_range(at..attr_end, "");
+        } else {
+            let attr_end = start + attribute.len();
+            let op_at = attr_end + result[attr_end..].find(&operation_attr).ok_or_else(|| invalid("missing operation attribute"))?;
+            result.replace_range(op_at..op_at + operation_attr.len(), &format!("#[link_name = \"__wasmc_canonical_bridge_{index}\"]"));
+            result.replace_range(start..attr_end, "");
+        }
+        seen.insert(key);
+    }
+    if seen.len() != bridges.len() { return Err(invalid("incomplete generated bridge bindings")); }
+    Ok(result)
+}
