+    /// Start a fresh provider for an invocation. The caller must keep this
+    /// instance inside the same state selected by every Lib callback.
+    pub fn instantiate(&self) -> Result<FreshCoreLibInstance> {
+        self.provider.instantiate_fresh()
+    }
+
+    /// Append one validated Lib binding, allowing other reviewed Host imports
+    /// to be interleaved in the exact Wasm import order.
+    pub fn bind_import<S: Send + 'static>(
+        &self,
+        session: Session<S>,
+        import: &Import,
+        expected_instance: wasmtime::Instance,
+        select: fn(&mut S) -> &mut FreshCoreLibInstance,
+    ) -> Result<Session<S>> {
+        ensure!(self.imports.iter().any(|i| i == import), "Core Lib import outside reviewed plan");
+        let name = import.name().to_string();
+        let is_memory = import.module() == MEMORY_MODULE;
+        let results = import.results().to_vec();
+        Ok(session.bind(import.clone(), move |state, memory, args| {
+            let provider = select(state);
+            if provider.instance() != expected_instance {
+                return Err(HostError::callback("Core Lib session provider changed"));
+            }
+            if is_memory { bridge(provider, memory, &name, args) }
+            else { provider_call(provider, &name, args, &results) }
+        }))
+    }
