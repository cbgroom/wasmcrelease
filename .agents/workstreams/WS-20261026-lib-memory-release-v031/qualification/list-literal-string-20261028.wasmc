package local:json_literal; interface api { enum json_error { invalid_json, invalid_pointer, missing_target, type_mismatch, invalid_index, out_of_range, invalid_operation, allocation_failed } run:func(value:u32)->result<string,json_error> {if (value == 0) {let item:string = "2"; return document::array_from_values([item,"true","\"雪\""]);} return document::array_from_values(["bad","true"]);} empty:func()->result<string,json_error> {return document::array_from_values([]);} } world app {export api;}
