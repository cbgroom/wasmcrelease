+#[cfg(test)]
+mod duplicate_regressions {
+    use super::*;
+    #[test]
+    fn duplicate_value_validation_handles_many_and_deep_inputs() {
+        let entries = (0..4096)
+            .map(|i| format!("\"k\":{i}"))
+            .collect::<Vec<_>>()
+            .join(",");
+        let input = format!("{{{entries}}}");
+        assert_eq!(compact(input.as_bytes()), Ok("{\"k\":4095}".into()));
+        let nested = format!("{}1e400{}", "[".repeat(5000), "]".repeat(5000));
+        let hidden = format!("{{\"k\":{nested},\"k\":1}}");
+        assert_eq!(validate(hidden.as_bytes()), Err(Error::InvalidJson));
+        assert_eq!(
+            edit(
+                br#"{"root":0}"#,
+                vec![Edit {
+                    kind: EditKind::Set,
+                    path: "/root".into(),
+                    value_json: hidden
+                }]
+            ),
+            Err(Error::InvalidJson)
+        );
+        assert_eq!(
+            compact(br#"{"recovery":true}"#),
+            Ok(r#"{"recovery":true}"#.into())
+        );
+    }
+
+    #[test]
+    fn duplicate_objects_match_serde_across_generated_cases() {
+        for i in 0..512_u64 {
+            let first = if i % 7 == 0 {
+                "1e400".to_owned()
+            } else {
+                format!("[{},{{\"n\":{}}}]", i, i * 3)
+            };
+            let raw = format!(r#"{{"x":{first},"a":true,"x":{{"v":{i}}},"x":{}}}"#, i + 1);
+            let expected = serde_json::from_str::<serde_json::Value>(&raw)
+                .map(|value| serde_json::to_string(&value).unwrap());
+            match expected {
+                Ok(value) => assert_eq!(compact(raw.as_bytes()), Ok(value), "{raw}"),
+                Err(_) => assert_eq!(compact(raw.as_bytes()), Err(Error::InvalidJson), "{raw}"),
+            }
+        }
+    }
+
+    #[test]
+    fn every_duplicate_value_is_validated_before_last_wins() {
+        for raw in [
+            r#"{"x":1e400,"x":1}"#,
+            r#"{"x":{"z":1e400},"x":1}"#,
+            r#"{"x":1,"x":1e400}"#,
+            r#"[{"z":1e400,"z":1}]"#,
+            r#"{"x":"\ud800","x":1}"#,
+        ] {
+            assert!(serde_json::from_str::<serde_json::Value>(raw).is_err());
+            assert_eq!(validate(raw.as_bytes()), Err(Error::InvalidJson), "{raw}");
+            assert_eq!(compact(raw.as_bytes()), Err(Error::InvalidJson), "{raw}");
+        }
+        for raw in [
+            r#"{"x":1,"x":2}"#,
+            r#"{"a":{"q":1,"q":2},"a":{"z":2,"z":3}}"#,
+            r#"{"x\u002fy":1,"x/y":2}"#,
+        ] {
+            let expected =
+                serde_json::to_string(&serde_json::from_str::<serde_json::Value>(raw).unwrap())
+                    .unwrap();
+            assert_eq!(compact(raw.as_bytes()), Ok(expected), "{raw}");
+        }
+        assert_eq!(validate(br#"{"ok":true}"#), Ok(()));
+    }
+}
