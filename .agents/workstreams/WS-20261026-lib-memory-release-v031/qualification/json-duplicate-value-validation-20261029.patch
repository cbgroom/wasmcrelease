+// `RawValue` has already checked the complete JSON grammar. Decode entries
+// in input order so values hidden by a later duplicate key are still parsed.
+fn object_entries(text: &str) -> Result<Vec<(String, &RawValue)>> {
+    let mut rest = text[1..text.len() - 1].trim_start();
+    let mut entries = Vec::new();
+    while !rest.is_empty() {
+        let mut keys = serde_json::Deserializer::from_str(rest).into_iter::<String>();
+        let key = json(keys.next().ok_or(Error::InvalidJson)?)?;
+        rest = &rest[keys.byte_offset()..];
+        rest = rest
+            .trim_start()
+            .strip_prefix(':')
+            .ok_or(Error::InvalidJson)?
+            .trim_start();
+        let mut values = serde_json::Deserializer::from_str(rest).into_iter::<&RawValue>();
+        let value = json(values.next().ok_or(Error::InvalidJson)?)?;
+        rest = rest[values.byte_offset()..].trim_start();
+        push(&mut entries, (key, value))?;
+        if rest.is_empty() {
+            break;
+        }
+        rest = rest
+            .strip_prefix(',')
+            .ok_or(Error::InvalidJson)?
+            .trim_start();
+    }
+    Ok(entries)
+}
