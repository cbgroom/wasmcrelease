+    assert_eq!(
+        format!("{:x}", Sha256::digest(CORE)),
+        "82e93fb61e11627d74b086693587fbb1a72d340432445236ae49f7df29670fe7"
+    );
+    struct Limits(CoreSharedMemoryReservation);
+    impl wasmtime::ResourceLimiter for Limits {
+        fn memory_growing(
+            &mut self,
+            current: usize,
+            desired: usize,
+            maximum: Option<usize>,
+        ) -> wasmtime::Result<bool> {
+            if maximum.is_some_and(|m| desired > m) {
+                return Ok(false);
+            }
+            Ok(self.0.try_grow(current, desired))
+        }
+        fn memory_grow_failed(&mut self, _error: wasmtime::Error) -> wasmtime::Result<()> {
+            self.0.growth_failed();
+            Ok(())
+        }
+        fn table_growing(
+            &mut self,
+            _: usize,
+            _: usize,
+            _: Option<usize>,
+        ) -> wasmtime::Result<bool> {
+            Ok(true)
+        }
+    }
+    struct JsonProvider {
+        store: wasmtime::Store<Limits>,
+        instance: wasmtime::Instance,
+        budget: CoreSharedMemoryBudget,
+    }
+    fn provider(budget: &CoreSharedMemoryBudget) -> JsonProvider {
+        let engine = wasmtime::Engine::default();
+        let module = wasmtime::Module::new(&engine, CORE).unwrap();
+        let mut store = wasmtime::Store::new(&engine, Limits(budget.reservation()));
+        store.limiter(|s| s);
+        let instance = wasmtime::Instance::new(&mut store, &module, &[]).unwrap();
+        assert_eq!(budget.reserved_bytes(), 17 * PAGE);
+        JsonProvider {
+            store,
+            instance,
+            budget: budget.clone(),
+        }
+    }
+    let wasm = wat::parse_str(
+        r#"(module
+      (import "host" "validate" (func $validate (param i32) (result i32)))
+      (memory (export "memory") 2)
+      (data (i32.const 64) "{\22a\22:1}") (data (i32.const 80) "{")
+      (func (export "run") (param i32) (result i32) local.get 0 call $validate))"#,
+    )
+    .unwrap();
+    let import = CoreScalarHostImport::new(
+        "host",
+        "validate",
+        vec![CoreScalarType::I32],
+        vec![CoreScalarType::I32],
+    );
+    let sdk = CoreRuntimeSdk::new(CoreRuntimeSdkConfig::new(2, 1)).unwrap();
+    let artifact = sdk
+        .prepare_scalar_host_core(&wasm, policy(92), std::slice::from_ref(&import))
+        .unwrap();
+    for optimized in [false, true] {
+        if optimized {
+            promote(&sdk, &artifact);
+        }
+        let insufficient = CoreSharedMemoryBudget::new(18 * PAGE);
+        let state = provider(&insufficient);
+        let session = CoreScalarHostSession::new(state)
+            .with_memory_budget(insufficient.clone())
+            .bind(import.clone(), |_, _, _| unreachable!());
+        let result =
+            artifact.invoke_scalar_with_session_state(session, "run", &[CoreScalarValue::I32(0)]);
+        assert!(result.invocation.is_err());
+        assert_eq!(insufficient.reserved_bytes(), 17 * PAGE);
+        drop(result.state);
+        assert_eq!(insufficient.reserved_bytes(), 0);
+        for (which, expected) in [(0, 0), (1, 1)] {
+            let budget = CoreSharedMemoryBudget::new(24 * PAGE);
+            let state = provider(&budget);
+            let session = CoreScalarHostSession::new(state)
+                .with_memory_budget(budget.clone())
+                .bind(import.clone(), |state, guest, args| {
+                    let [CoreScalarValue::I32(which)] = args else {
+                        unreachable!()
+                    };
+                    let (offset, len) = if *which == 0 { (64, 7) } else { (80, 1) };
+                    let mut input = vec![0; len];
+                    guest.read(offset, &mut input)?;
+                    let realloc = state
+                        .instance
+                        .get_typed_func::<(i32, i32, i32, i32), i32>(
+                            &mut state.store,
+                            "cabi_realloc",
+                        )
+                        .unwrap();
+                    let ptr = realloc
+                        .call(&mut state.store, (0, 0, 1, len as i32))
+                        .unwrap();
+                    let memory = state
+                        .instance
+                        .get_memory(&mut state.store, "memory")
+                        .unwrap();
+                    memory
+                        .write(&mut state.store, ptr as usize, &input)
+                        .unwrap();
+                    let validate = state
+                        .instance
+                        .get_typed_func::<(i32, i32), i32>(
+                            &mut state.store,
+                            "wasmc:json/document@0.2.1#validate",
+                        )
+                        .unwrap();
+                    let result_ptr = validate.call(&mut state.store, (ptr, len as i32)).unwrap();
+                    let mut tag = [0u8; 1];
