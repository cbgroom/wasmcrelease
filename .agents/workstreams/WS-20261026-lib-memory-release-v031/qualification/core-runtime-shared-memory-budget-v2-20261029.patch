+//! Shared, invocation-owned accounting for linear memories in separate stores.
+use std::sync::{
+    Arc,
+    atomic::{AtomicUsize, Ordering},
+};
+
+#[derive(Clone, Debug)]
+pub struct CoreSharedMemoryBudget(Arc<Inner>);
+
+#[derive(Debug)]
+struct Inner {
+    limit: usize,
+    reserved: AtomicUsize,
+}
+
+/// A store-owned reservation. Drop it only after the associated store is gone.
+#[derive(Debug)]
+pub struct CoreSharedMemoryReservation {
+    budget: CoreSharedMemoryBudget,
+    held: usize,
+    pending: usize,
+}
+
+impl CoreSharedMemoryBudget {
+    pub fn new(limit_bytes: usize) -> Self {
+        Self(Arc::new(Inner {
+            limit: limit_bytes,
+            reserved: AtomicUsize::new(0),
+        }))
+    }
+    pub fn limit_bytes(&self) -> usize {
+        self.0.limit
+    }
+    pub fn reserved_bytes(&self) -> usize {
+        self.0.reserved.load(Ordering::Acquire)
+    }
+    /// True only when both handles refer to the same invocation budget.
+    pub fn same_budget(&self, other: &Self) -> bool {
+        Arc::ptr_eq(&self.0, &other.0)
+    }
+    pub fn reservation(&self) -> CoreSharedMemoryReservation {
+        CoreSharedMemoryReservation {
+            budget: self.clone(),
+            held: 0,
+            pending: 0,
+        }
+    }
+}
+
+impl CoreSharedMemoryReservation {
+    /// Reserve a growth delta before allowing an engine to grow one memory.
+    /// The store's limiter must call `growth_failed` when an allowed grow fails.
+    pub fn try_grow(&mut self, current: usize, desired: usize) -> bool {
+        self.pending = 0;
+        let Some(delta) = desired.checked_sub(current) else {
+            return false;
+        };
+        let mut used = self.budget.0.reserved.load(Ordering::Acquire);
+        loop {
+            let Some(next) = used.checked_add(delta) else {
+                return false;
+            };
+            if next > self.budget.0.limit {
+                return false;
+            }
+            match self.budget.0.reserved.compare_exchange_weak(
+                used,
+                next,
+                Ordering::AcqRel,
+                Ordering::Acquire,
+            ) {
+                Ok(_) => {
+                    self.held += delta;
+                    self.pending = delta;
+                    return true;
+                }
+                Err(actual) => used = actual,
+            }
+        }
+    }
+    /// Undo the most recently admitted grow when the engine could not allocate it.
+    pub fn growth_failed(&mut self) {
+        self.held -= self.pending;
+        self.budget
+            .0
+            .reserved
+            .fetch_sub(self.pending, Ordering::AcqRel);
+        self.pending = 0;
+    }
+}
+impl Drop for CoreSharedMemoryReservation {
+    fn drop(&mut self) {
+        self.budget
+            .0
+            .reserved
+            .fetch_sub(self.held, Ordering::AcqRel);
+    }
+}
+
+#[cfg(feature = "wasmi-runtime")]
+pub(crate) struct WasmiSharedLimits {
+    pub limits: wasmi::StoreLimits,
+    pub reservation: Option<CoreSharedMemoryReservation>,
+}
+
+#[cfg(feature = "wasmi-runtime")]
+impl wasmi::ResourceLimiter for WasmiSharedLimits {
+    fn memory_growing(
+        &mut self,
+        current: usize,
+        desired: usize,
+        maximum: Option<usize>,
+    ) -> Result<bool, wasmi_core::LimiterError> {
+        if !wasmi::ResourceLimiter::memory_growing(&mut self.limits, current, desired, maximum)? {
+            return Ok(false);
+        }
+        if self
+            .reservation
+            .as_mut()
+            .is_some_and(|r| !r.try_grow(current, desired))
+        {
+            return Err(wasmi_core::LimiterError::ResourceLimiterDeniedAllocation);
+        }
+        Ok(true)
+    }
+    fn memory_grow_failed(
+        &mut self,
+        error: &wasmi::errors::MemoryError,
+    ) -> Result<(), wasmi_core::LimiterError> {
+        if let Some(r) = &mut self.reservation {
+            r.growth_failed();
+        }
+        // A fuel quantum can be replenished by the resumable Wasmi driver.
+        // Turning it into a limiter denial would prevent that recovery.
+        if matches!(error, wasmi::errors::MemoryError::OutOfFuel { .. }) {
+            return Ok(());
+        }
+        wasmi::ResourceLimiter::memory_grow_failed(&mut self.limits, error)
+    }
+    fn table_growing(
+        &mut self,
+        current: usize,
+        desired: usize,
+        maximum: Option<usize>,
+    ) -> Result<bool, wasmi_core::LimiterError> {
+        wasmi::ResourceLimiter::table_growing(&mut self.limits, current, desired, maximum)
+    }
+    fn table_grow_failed(
+        &mut self,
+        error: &wasmi::errors::TableError,
+    ) -> Result<(), wasmi_core::LimiterError> {
+        wasmi::ResourceLimiter::table_grow_failed(&mut self.limits, error)
+    }
+    fn instances(&self) -> usize {
+        wasmi::ResourceLimiter::instances(&self.limits)
+    }
+    fn tables(&self) -> usize {
+        wasmi::ResourceLimiter::tables(&self.limits)
+    }
+    fn memories(&self) -> usize {
+        wasmi::ResourceLimiter::memories(&self.limits)
+    }
+}
+
+#[cfg(all(feature = "wasmi-runtime", feature = "wasmtime-runtime"))]
+pub(crate) struct WasmtimeSharedLimits {
+    pub limits: wasmtime::StoreLimits,
+    pub reservation: Option<CoreSharedMemoryReservation>,
+}
+
+#[cfg(all(feature = "wasmi-runtime", feature = "wasmtime-runtime"))]
+impl wasmtime::ResourceLimiter for WasmtimeSharedLimits {
+    fn memory_growing(
+        &mut self,
+        current: usize,
+        desired: usize,
+        maximum: Option<usize>,
+    ) -> wasmtime::Result<bool> {
+        if !wasmtime::ResourceLimiter::memory_growing(&mut self.limits, current, desired, maximum)?
+        {
+            return Ok(false);
+        }
+        if self
+            .reservation
+            .as_mut()
+            .is_some_and(|r| !r.try_grow(current, desired))
+        {
+            return Err(wasmtime::Error::msg(
+                "resource limiter denied shared memory allocation",
+            ));
+        }
+        Ok(true)
+    }
+    fn memory_grow_failed(&mut self, error: wasmtime::Error) -> wasmtime::Result<()> {
+        if let Some(r) = &mut self.reservation {
+            r.growth_failed();
+        }
+        wasmtime::ResourceLimiter::memory_grow_failed(&mut self.limits, error)
+    }
+    fn table_growing(
+        &mut self,
+        current: usize,
+        desired: usize,
+        maximum: Option<usize>,
+    ) -> wasmtime::Result<bool> {
+        wasmtime::ResourceLimiter::table_growing(&mut self.limits, current, desired, maximum)
+    }
+    fn table_grow_failed(&mut self, error: wasmtime::Error) -> wasmtime::Result<()> {
+        wasmtime::ResourceLimiter::table_grow_failed(&mut self.limits, error)
+    }
+    fn instances(&self) -> usize {
+        wasmtime::ResourceLimiter::instances(&self.limits)
+    }
+    fn tables(&self) -> usize {
+        wasmtime::ResourceLimiter::tables(&self.limits)
+    }
+    fn memories(&self) -> usize {
+        wasmtime::ResourceLimiter::memories(&self.limits)
+    }
+}
