+#[test]
+fn shared_memory_budget_joins_guest_and_provider_stores() {
+    use wasmc_core_runtime::{CoreSharedMemoryBudget, CoreSharedMemoryReservation};
+    const PAGE: usize = 65536;
+    struct ProviderLimits(CoreSharedMemoryReservation);
+    impl wasmtime::ResourceLimiter for ProviderLimits {
+        fn memory_growing(
+            &mut self,
+            current: usize,
+            desired: usize,
+            maximum: Option<usize>,
+        ) -> wasmtime::Result<bool> {
+            if maximum.is_some_and(|m| desired > m) {
+                return Ok(false);
+            }
+            Ok(self.0.try_grow(current, desired))
+        }
+        fn memory_grow_failed(&mut self, _error: wasmtime::Error) -> wasmtime::Result<()> {
+            self.0.growth_failed();
+            Ok(())
+        }
+        fn table_growing(
+            &mut self,
+            _current: usize,
+            _desired: usize,
+            _maximum: Option<usize>,
+        ) -> wasmtime::Result<bool> {
+            Ok(true)
+        }
+    }
+    struct State {
+        store: wasmtime::Store<ProviderLimits>,
+        memory: wasmtime::Memory,
+        budget: CoreSharedMemoryBudget,
+    }
+    fn provider(budget: &CoreSharedMemoryBudget, pages: u32) -> State {
+        let engine = wasmtime::Engine::default();
+        let mut store = wasmtime::Store::new(&engine, ProviderLimits(budget.reservation()));
+        store.limiter(|s| s);
+        let memory =
+            wasmtime::Memory::new(&mut store, wasmtime::MemoryType::new(pages, None)).unwrap();
+        State {
+            store,
+            memory,
+            budget: budget.clone(),
+        }
+    }
+    let wasm = wat::parse_str(
+        r#"(module
+      (import "host" "total" (func $total (result i32)))
+      (memory (export "memory") 2)
+      (func (export "run") (result i32) call $total)
+      (func (export "grow") (result i32) i32.const 1 memory.grow))"#,
+    )
+    .unwrap();
+    let import = CoreScalarHostImport::new("host", "total", vec![], vec![CoreScalarType::I32]);
+    let profile = CoreRuntimeLimitProfile::bounded(
+        1_000_000,
+        1_000_000,
+        1_000_000_000,
+        1_000,
+        4 * PAGE,
+        8,
+        1,
+    );
+    let sdk = CoreRuntimeSdk::new(CoreRuntimeSdkConfig::new(2, 1).with_limits(profile)).unwrap();
+    let artifact = sdk
+        .prepare_scalar_host_core(&wasm, policy(90), std::slice::from_ref(&import))
+        .unwrap();
+    for optimized in [false, true] {
+        if optimized {
+            promote(&sdk, &artifact);
+        }
+        // Two provider pages plus two Guest pages exceed a three-page budget.
+        let budget = CoreSharedMemoryBudget::new(3 * PAGE);
+        let state = provider(&budget, 2);
+        let session = CoreScalarHostSession::new(state)
+            .with_memory_budget(budget.clone())
+            .bind(import.clone(), |_, _, _| Ok(vec![CoreScalarValue::I32(0)]));
+        let rejected = artifact.invoke_scalar_with_session_state(session, "run", &[]);
+        assert!(
+            rejected.invocation.is_err(),
+            "combined memory budget was bypassed"
+        );
+        assert_eq!(
+            budget.reserved_bytes(),
+            2 * PAGE,
+            "failed Guest instantiation retained a reservation"
+        );
+        drop(rejected.state);
+        assert_eq!(budget.reserved_bytes(), 0);
+        // With one provider page, both stores fit exactly. A further provider grow
+        // is rejected without corrupting accounting; a fresh invocation recovers.
+        for _ in 0..2 {
+            let state = provider(&budget, 1);
+            let session = CoreScalarHostSession::new(state)
+                .with_memory_budget(budget.clone())
+                .bind(import.clone(), |state, memory, _| {
+                    assert_eq!(memory.byte_len()?, 2 * PAGE);
+                    assert_eq!(state.budget.reserved_bytes(), 3 * PAGE);
+                    assert!(state.memory.grow(&mut state.store, 1).is_err());
+                    assert_eq!(state.budget.reserved_bytes(), 3 * PAGE);
+                    Ok(vec![CoreScalarValue::I32(3 * PAGE as i32)])
+                });
+            let outcome = artifact.invoke_scalar_with_session_state(session, "run", &[]);
+            let value = outcome.invocation.unwrap();
+            assert_eq!(
+                value.backend,
+                if optimized {
+                    CoreRuntimeBackend::Wasmtime
+                } else {
+                    CoreRuntimeBackend::Wasmi
+                }
+            );
+            assert_eq!(value.values, [CoreScalarValue::I32(3 * PAGE as i32)]);
+            assert_eq!(budget.reserved_bytes(), PAGE, "Guest memory not released");
+            drop(outcome.state);
+            assert_eq!(budget.reserved_bytes(), 0, "provider memory not released");
+        }
+        // Guest growth is also charged while the provider remains alive.
+        let budget = CoreSharedMemoryBudget::new(3 * PAGE);
+        let state = provider(&budget, 1);
+        let session = CoreScalarHostSession::new(state)
+            .with_memory_budget(budget.clone())
+            .bind(import.clone(), |_, _, _| unreachable!());
+        let rejected = artifact.invoke_scalar_with_session_state(session, "grow", &[]);
+        assert!(
+            rejected.invocation.is_err(),
+            "Guest growth bypassed combined budget"
+        );
+        assert_eq!(budget.reserved_bytes(), PAGE);
+        drop(rejected.state);
+        assert_eq!(budget.reserved_bytes(), 0);
+        let budget = CoreSharedMemoryBudget::new(4 * PAGE);
+        let state = provider(&budget, 1);
+        let session = CoreScalarHostSession::new(state)
+            .with_memory_budget(budget.clone())
+            .bind(import.clone(), |_, _, _| unreachable!());
+        let grown = artifact.invoke_scalar_with_session_state(session, "grow", &[]);
+        assert_eq!(grown.invocation.unwrap().values, [CoreScalarValue::I32(2)]);
+        assert_eq!(budget.reserved_bytes(), PAGE);
+        drop(grown.state);
+        assert_eq!(budget.reserved_bytes(), 0);
+        // Both stores may grow up to the common ceiling, with no fixed partition.
+        let budget = CoreSharedMemoryBudget::new(4 * PAGE);
+        let state = provider(&budget, 1);
+        let session = CoreScalarHostSession::new(state)
+            .with_memory_budget(budget.clone())
+            .bind(import.clone(), |state, _, _| {
+                state.memory.grow(&mut state.store, 1).unwrap();
+                assert_eq!(state.budget.reserved_bytes(), 4 * PAGE);
+                Ok(vec![CoreScalarValue::I32(4 * PAGE as i32)])
+            });
+        let outcome = artifact.invoke_scalar_with_session_state(session, "run", &[]);
+        assert_eq!(
+            outcome.invocation.unwrap().values,
+            [CoreScalarValue::I32(4 * PAGE as i32)]
+        );
+        assert_eq!(budget.reserved_bytes(), 2 * PAGE);
+        drop(outcome.state);
+        assert_eq!(budget.reserved_bytes(), 0);
+    }
+    // Explicit shared accounting also applies when the SDK profile is unbounded.
+    let unbounded_sdk = CoreRuntimeSdk::new(CoreRuntimeSdkConfig::new(2, 1)).unwrap();
+    let unbounded_artifact = unbounded_sdk
+        .prepare_scalar_host_core(&wasm, policy(91), std::slice::from_ref(&import))
+        .unwrap();
+    for optimized in [false, true] {
+        if optimized {
+            promote(&unbounded_sdk, &unbounded_artifact);
+        }
+        let budget = CoreSharedMemoryBudget::new(2 * PAGE);
+        let state = provider(&budget, 1);
+        let session = CoreScalarHostSession::new(state)
+            .with_memory_budget(budget.clone())
+            .bind(import.clone(), |_, _, _| unreachable!());
+        let rejected = unbounded_artifact.invoke_scalar_with_session_state(session, "run", &[]);
+        assert!(
+            rejected.invocation.is_err(),
+            "unbounded SDK ignored explicit shared budget"
+        );
+        assert_eq!(budget.reserved_bytes(), PAGE);
+        drop(rejected.state);
+        assert_eq!(budget.reserved_bytes(), 0);
+        let budget = CoreSharedMemoryBudget::new(3 * PAGE);
+        let state = provider(&budget, 1);
+        let session = CoreScalarHostSession::new(state)
+            .with_memory_budget(budget.clone())
+            .bind(import.clone(), |state, _, _| {
+                Ok(vec![CoreScalarValue::I32(
+                    state.budget.reserved_bytes() as i32
+                )])
+            });
+        let accepted = unbounded_artifact.invoke_scalar_with_session_state(session, "run", &[]);
+        assert_eq!(
+            accepted.invocation.unwrap().values,
+            [CoreScalarValue::I32(3 * PAGE as i32)]
+        );
+        assert_eq!(budget.reserved_bytes(), PAGE);
+        drop(accepted.state);
+        assert_eq!(budget.reserved_bytes(), 0);
+    }
+    // Concurrent stores contend for the same total, not independent per-store caps.
+    let concurrent = CoreSharedMemoryBudget::new(3 * PAGE);
+    let successes = std::sync::atomic::AtomicUsize::new(0);
+    let barrier = std::sync::Barrier::new(4);
+    std::thread::scope(|scope| {
+        for _ in 0..4 {
+            let budget = concurrent.clone();
+            let successes = &successes;
+            let barrier = &barrier;
+            scope.spawn(move || {
+                let engine = wasmtime::Engine::default();
+                let mut store = wasmtime::Store::new(&engine, ProviderLimits(budget.reservation()));
+                store.limiter(|s| s);
+                let memory = wasmtime::Memory::new(&mut store, wasmtime::MemoryType::new(1, None));
+                if memory.is_ok() {
+                    successes.fetch_add(1, std::sync::atomic::Ordering::SeqCst);
+                }
+                barrier.wait();
+                drop(memory);
+                drop(store);
+            });
+        }
+    });
+    assert_eq!(successes.load(std::sync::atomic::Ordering::SeqCst), 3);
+    assert_eq!(concurrent.reserved_bytes(), 0);
+    let budget = CoreSharedMemoryBudget::new(PAGE);
+    let mut reservation = budget.reservation();
+    assert!(reservation.try_grow(0, PAGE));
+    reservation.growth_failed();
+    assert_eq!(budget.reserved_bytes(), 0);
+}
