package wasmc:system-app-authorization@0.0.1;

interface authorization {
  enum capability {
    camera,
    microphone,
    location-when-in-use,
    motion,
    notifications,
    photos-read-write,
    contacts,
    calendar,
    reminders,
    speech-recognition,
  }
  enum state {
    not-required,
    unavailable,
    not-determined,
    denied,
    restricted,
    authorized,
    limited,
    provisional,
    ephemeral,
    unknown,
  }
  enum plan {
    no-request,
    request,
    wait-for-in-flight-request,
    open-settings,
    fail-closed,
  }
  record decision {
    capability: capability,
    state: state,
    attempt-count: u32,
    request-in-flight: bool,
    plan: plan,
  }
  snapshot: func() -> list<decision>;
  plan-request: func(capabilities: list<capability>) -> list<decision>;
  begin-request: func(capability: capability) -> result<u32, s32>;
  complete-request: func(capability: capability, request-id: u32, observed-state: state) -> result<_, s32>;
}

world system-app-authorization {
  export authorization;
}
