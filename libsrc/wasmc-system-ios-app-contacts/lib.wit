package wasmc:system-app-contacts@0.0.1;

interface contacts {
  record qualification-result {
    authorization: string,
    use-attempted: bool,
    created: bool,
    fetched: bool,
    deleted: bool,
    cleanup-confirmed: bool,
  }
  qualification-roundtrip: func() -> result<qualification-result, s32>;
}

world system-app-contacts {
  export contacts;
}
