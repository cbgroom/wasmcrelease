package wasmc:system-network-path@0.0.1;

interface network-path {
  enum status {
    satisfied,
    unsatisfied,
    requires-connection,
    unknown,
  }

  enum interface-kind {
    wifi,
    cellular,
    wired-ethernet,
    loopback,
    other,
  }

  record snapshot {
    status: status,
    interfaces: list<interface-kind>,
    expensive: bool,
    constrained: bool,
    supports-ipv4: bool,
    supports-ipv6: bool,
    supports-dns: bool,
    generation: u64,
  }

  inspect: func() -> snapshot;
}

world system-network-path {
  export network-path;
}
