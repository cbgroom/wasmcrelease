{
  "schema": "wasmc.current-original-producer-source/v1",
  "id": "wasmc-json",
  "version": "0.0.6",
  "profile": "value",
  "world": "json",
  "description": "Bounded JSON compact, validation and parse-once pointer selection backed by pinned serde_json, plus independent owned UTF8 encoding without external authority.",
  "apis": [
    {
      "api": "compact",
      "delta": "Bounded JSON parse and compact serialization; sorted object keys, last duplicate key wins, no lexical number preservation or JCS claim.",
      "ecosystem": "serde_json 1.0.151 from_str and to_writer",
      "host_authorities": [],
      "implementation": "lib",
      "origin": "adapted",
      "support": "supported"
    },
    {
      "api": "compact-bytes",
      "delta": "Copied list<u8> input; invalid UTF-8 is invalid-json. Bounded JSON parse and compact serialization; sorted object keys, last duplicate key wins, no lexical number preservation or JCS claim.",
      "ecosystem": "serde_json 1.0.151 from_slice and to_writer",
      "host_authorities": [],
      "implementation": "lib",
      "origin": "adapted",
      "support": "supported"
    },
    {
      "api": "compact-or",
      "delta": "Same bounded compact text semantics with exactly the caller fallback on a documented JsonError.",
      "ecosystem": "serde_json 1.0.151 Value::pointer and string decoding",
      "host_authorities": [],
      "implementation": "lib",
      "origin": "adapted",
      "support": "supported"
    },
    {
      "api": "compact-or-bytes",
      "delta": "Same bounded compact-bytes parse/serialization; returns the caller-supplied owned fallback on any JsonError. No lossy UTF8 and no external authority.",
      "ecosystem": "serde_json 1.0.151; explicit Result::unwrap_or in Lib",
      "host_authorities": [],
      "implementation": "lib",
      "origin": "adapted",
      "support": "supported"
    },
    {
      "api": "decode-string-or",
      "delta": "Same bounded JSON validation, followed by serde_json UTF8 string decoding. Return exactly caller fallback on non-string values or documented JsonError.",
      "ecosystem": "serde_json 1.0.151 Value::pointer and string decoding",
      "host_authorities": [],
      "implementation": "lib",
      "origin": "adapted",
      "support": "supported"
    },
    {
      "api": "encode",
      "delta": null,
      "ecosystem": "Rust standard library String::into_bytes",
      "host_authorities": [],
      "implementation": "lib",
      "origin": "exact",
      "support": "supported"
    },
    {
      "api": "inspect-values-bytes",
      "delta": "Plain record view of the existing parse-once selected-value batch: valid=true and complete values on success; valid=false/empty values/documented error on failure. Same bounds and no partial publication.",
      "ecosystem": "serde_json 1.0.151 Value::pointer and string decoding",
      "host_authorities": [],
      "implementation": "lib",
      "origin": "adapted",
      "support": "supported"
    },
    {
      "api": "select",
      "delta": "Parses once and selects at most 64 strict JSON pointers; None means missing, Some(null) means JSON null; selected JSON strings share a 65536-byte output cap.",
      "ecosystem": "serde_json 1.0.151 Value::pointer",
      "host_authorities": [],
      "implementation": "lib",
      "origin": "adapted",
      "support": "supported"
    },
    {
      "api": "select-bytes",
      "delta": "Copied list<u8> input; invalid UTF-8 is invalid-json. Parses once and selects at most 64 strict JSON pointers; None means missing, Some(null) means JSON null; selected JSON strings share a 65536-byte output cap.",
      "ecosystem": "serde_json 1.0.151 Value::pointer",
      "host_authorities": [],
      "implementation": "lib",
      "origin": "adapted",
      "support": "supported"
    },
    {
      "api": "select-string-or-bytes",
      "delta": "Same bounded pointer selection; decode a selected JSON string to owned UTF8 text. Return caller fallback for missing, non-string values or any JsonError. Original eight APIs unchanged.",
      "ecosystem": "serde_json 1.0.151 Value::pointer and from_str<String>",
      "host_authorities": [],
      "implementation": "lib",
      "origin": "adapted",
      "support": "supported"
    },
    {
      "api": "select-values",
      "delta": "Record view of select: present distinguishes missing from JSON null; json carries the same bounded compact JSON value. Reuses the same single parse, pointer order, errors and shared 65536-byte output cap.",
      "ecosystem": "serde_json 1.0.151 Value::pointer",
      "host_authorities": [],
      "implementation": "lib",
      "origin": "adapted",
      "support": "supported"
    },
    {
      "api": "select-values-bytes",
      "delta": "Copied list<u8> record view of select-bytes, with exact UTF-8 validation and present/json fields. Reuses the same parse and bounds; no Host access.",
      "ecosystem": "serde_json 1.0.151 Value::pointer",
      "host_authorities": [],
      "implementation": "lib",
      "origin": "adapted",
      "support": "supported"
    },
    {
      "api": "validate",
      "delta": "Input is UTF-8 JSON text bounded to 65536 bytes and 64 open containers; parser failures become invalid-json with no partial result.",
      "ecosystem": "serde_json 1.0.151 from_str",
      "host_authorities": [],
      "implementation": "lib",
      "origin": "adapted",
      "support": "supported"
    },
    {
      "api": "validate-bytes",
      "delta": "Copied list<u8> input; invalid UTF-8 is invalid-json. Input is UTF-8 JSON text bounded to 65536 bytes and 64 open containers; parser failures become invalid-json with no partial result.",
      "ecosystem": "serde_json 1.0.151 from_slice",
      "host_authorities": [],
      "implementation": "lib",
      "origin": "adapted",
      "support": "supported"
    }
  ],
