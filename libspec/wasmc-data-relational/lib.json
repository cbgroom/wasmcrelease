      "ecosystem": "Arrow Arith 60",
      "host_authorities": [],
      "implementation": "lib",
      "origin": "adapted",
      "support": "supported"
    },
    {
      "api": "union-all",
      "delta": "Schema-checked append of compatible batches. Capacity follows aggregate memory; type/schema/overflow checks remain.",
      "ecosystem": "neutral Data model",
      "host_authorities": [],
      "implementation": "lib",
      "origin": "adapted",
      "support": "supported"
    },
    {
      "api": "window-aggregate",
      "delta": "ROWS-frame window aggregates. Capacity follows aggregate memory; type/schema/overflow checks remain.",
      "ecosystem": "Arrow Arith 60",
      "host_authorities": [],
      "implementation": "lib",
      "origin": "adapted",
      "support": "supported"
    },
    {
      "api": "window-offset",
