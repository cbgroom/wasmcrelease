{
  "schema": "wasmc.lib-refresh-rust-policy/v2",
  "toolchain": "1.96.0",
  "target": "wasm32-unknown-unknown",
  "edition": "2021",
  "wit_bindgen": "\"=0.62.0\"",
  "dependencies": {
    "serde_json": "\"=1.0.151\"",
    "flate2": "{ version = \"=1.1.10\", default-features = false, features = [\"rust_backend\"] }",
    "httparse": "\"=1.10.1\"",
    "arrow-schema": "\"=60.0.0\"",
    "arrow-array": "\"=60.0.0\"",
    "arrow-select": "\"=60.0.0\"",
    "arrow-ord": "\"=60.0.0\"",
    "arrow-arith": "\"=60.0.0\"",
    "arrow-ipc": "\"=60.0.0\"",
    "bytes": "\"=1.12.1\"",
    "parquet": "{ version = \"=60.0.0\", default-features = false, features = [\"arrow\"] }",
    "ordered-float": "{ version = \"=5.5.0\", default-features = false }",
    "arrow-csv": "\"=60.0.0\""
  },
  "release_profile": {
    "opt_level": "z",
    "lto": true,
    "codegen_units": 1,
    "panic": "abort",
    "strip": "symbols"
  },
  "shared_modules": {
    "data-arrow": {
      "source": "libspec/shared/data-arrow.rs",
      "module": "data_arrow",
      "dependencies": [
        "arrow-schema",
        "arrow-array"
      ]
    }
  }
}
