package wasmc:data-compute@0.0.1;

interface compute {
  use wasmc:data-core/types@0.0.1.{column, batch-snapshot};

  record sort-key {
    column: u32,
    descending: bool,
    nulls-first: bool,
  }

  enum compute-error {
    invalid-batch,
    mask-type-mismatch,
    mask-length-mismatch,
    column-out-of-bounds,
    duplicate-column,
    empty-sort,
    compute-failure,
  }

  filter: func(value: batch-snapshot, mask: column) -> result<batch-snapshot, compute-error>;

  project: func(value: batch-snapshot, columns: list<u32>) -> result<batch-snapshot, compute-error>;

  sort: func(value: batch-snapshot, keys: list<sort-key>, limit: option<u32>) -> result<batch-snapshot, compute-error>;
}

world data-compute {
  import wasmc:data-core/types@0.0.1;

  export compute;
}
package wasmc:data-core@0.0.1 {
  interface types {
    enum data-type {
      boolean,
      int64,
      uint64,
      %float64,
      utf8,
      binary,
    }

    record field {
      name: string,
      data-type: data-type,
      nullable: bool,
    }

    variant column {
      boolean-column(list<option<bool>>),
      int64-column(list<option<s64>>),
      uint64-column(list<option<u64>>),
      float64-column(list<option<f64>>),
      utf8-column(list<option<string>>),
      binary-column(list<option<list<u8>>>),
    }

    record batch-snapshot {
      rows: u32,
      fields: list<field>,
      columns: list<column>,
    }

    enum data-error {
      column-count-mismatch,
      row-count-mismatch,
      type-mismatch,
      nullability-violation,
      empty-field-name,
      duplicate-field-name,
      index-out-of-bounds,
      invalid-layout,
    }
  }
  interface model {
    use types.{batch-snapshot, data-error};

    validate: func(value: batch-snapshot) -> result<u32, data-error>;

    take: func(value: batch-snapshot, indices: list<u32>) -> result<batch-snapshot, data-error>;
  }
  world data-core {
    export types;
    export model;
  }
}
