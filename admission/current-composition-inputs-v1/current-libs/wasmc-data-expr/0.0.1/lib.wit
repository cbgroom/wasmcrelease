package wasmc:data-expr@0.0.1;

interface expr {
  use wasmc:data-core/types@0.0.1.{data-type, column, batch-snapshot};

  record unary {
    input: u32,
  }

  record binary {
    left: u32,
    right: u32,
  }

  variant literal {
    boolean(bool),
    int64(s64),
    uint64(u64),
    %float64(f64),
    utf8(string),
    typed-null(data-type),
  }

  variant node {
    column(u32),
    literal(literal),
    equal(binary),
    not-equal(binary),
    less(binary),
    less-equal(binary),
    greater(binary),
    greater-equal(binary),
    add(binary),
    subtract(binary),
    multiply(binary),
    divide(binary),
    logical-and(binary),
    logical-or(binary),
    logical-not(unary),
    is-null(unary),
  }

  record program {
    nodes: list<node>,
    root: u32,
  }

  enum expr-error {
    empty-program,
    root-out-of-bounds,
    forward-reference,
    column-out-of-bounds,
    type-mismatch,
    unsupported-type,
    compute-failure,
    invalid-program,
  }

  validate: func(value: batch-snapshot, expression: program) -> result<data-type, expr-error>;

  evaluate: func(value: batch-snapshot, expression: program) -> result<column, expr-error>;
}

world data-expr {
  import wasmc:data-core/types@0.0.1;

  export expr;
}
package wasmc:data-core@0.0.1 {
  interface types {
    enum data-type {
      boolean,
      int64,
      uint64,
      %float64,
      utf8,
      binary,
    }

    record field {
      name: string,
      data-type: data-type,
      nullable: bool,
    }

    variant column {
      boolean-column(list<option<bool>>),
      int64-column(list<option<s64>>),
      uint64-column(list<option<u64>>),
      float64-column(list<option<f64>>),
      utf8-column(list<option<string>>),
      binary-column(list<option<list<u8>>>),
    }

    record batch-snapshot {
      rows: u32,
      fields: list<field>,
      columns: list<column>,
    }

    enum data-error {
      column-count-mismatch,
      row-count-mismatch,
      type-mismatch,
      nullability-violation,
      empty-field-name,
      duplicate-field-name,
      index-out-of-bounds,
      invalid-layout,
    }
  }
  interface model {
    use types.{batch-snapshot, data-error};

    validate: func(value: batch-snapshot) -> result<u32, data-error>;

    take: func(value: batch-snapshot, indices: list<u32>) -> result<batch-snapshot, data-error>;
  }
  world data-core {
    export types;
    export model;
  }
}
