package local:text_glue;
interface api {
 record query_pair {name:string,value:string}
 record header {name:string,value:list<u8>}
 record request {method:string,path:string,parameters:list<query_pair>,query:list<query_pair>,headers:list<header>,body:list<u8>}
 record response {status:u16,body:list<u8>}
 run:func(req:request)->response {
 let input:string = text::from_utf8_lossy(req.body);
 let zero:u32 = 0; let one:u32 = 1; let two:u32 = 2; let three:u32 = 3; let seven:u32 = 7;
 if (req.path == "/trim") {return {status:200,body:text::into_bytes(text::trim(input))};}
 if (req.path == "/trim_start") {return {status:200,body:text::into_bytes(text::trim_start(input))};}
 if (req.path == "/trim_end") {return {status:200,body:text::into_bytes(text::trim_end(input))};}
 if (req.path == "/to_lowercase") {return {status:200,body:text::into_bytes(text::to_lowercase(input))};}
 if (req.path == "/to_uppercase") {return {status:200,body:text::into_bytes(text::to_uppercase(input))};}
 if (req.path == "/to_ascii_lowercase") {return {status:200,body:text::into_bytes(text::to_ascii_lowercase(input))};}
 if (req.path == "/to_ascii_uppercase") {return {status:200,body:text::into_bytes(text::to_ascii_uppercase(input))};}
 if (req.path == "/split") {return {status:200,body:text::into_bytes(text::join(text::split(input,","),"|"))};}
 if (req.path == "/splitn") {return {status:200,body:text::into_bytes(text::join(text::splitn(input,two,"="),"|"))};}
 if (req.path == "/split_whitespace") {return {status:200,body:text::into_bytes(text::join(text::split_whitespace(input),"|"))};}
 if (req.path == "/split_ascii_whitespace") {return {status:200,body:text::into_bytes(text::join(text::split_ascii_whitespace(input),"|"))};}
 if (req.path == "/lines") {return {status:200,body:text::into_bytes(text::join(text::lines(input),"|"))};}
 if (req.path == "/replace") {return {status:200,body:text::into_bytes(text::replace(input,".","$1"))};}
 if (req.path == "/replacen") {return {status:200,body:text::into_bytes(text::replacen(input,"a","X",two))};}
 if (req.path == "/contains") {if (text::contains(input,"雪")) {return {status:200,body:text::into_bytes("true")};} return {status:200,body:text::into_bytes("false")};}
 if (req.path == "/starts_with") {if (text::starts_with(input,"雪")) {return {status:200,body:text::into_bytes("true")};} return {status:200,body:text::into_bytes("false")};}
 if (req.path == "/ends_with") {if (text::ends_with(input,"🦀")) {return {status:200,body:text::into_bytes("true")};} return {status:200,body:text::into_bytes("false")};}
 if (req.path == "/is_empty") {if (text::is_empty(input)) {return {status:200,body:text::into_bytes("true")};} return {status:200,body:text::into_bytes("false")};}
 if (req.path == "/is_ascii") {if (text::is_ascii(input)) {return {status:200,body:text::into_bytes("true")};} return {status:200,body:text::into_bytes("false")};}
 if (req.path == "/eq_ignore_ascii_case") {if (text::eq_ignore_ascii_case(input,"GET")) {return {status:200,body:text::into_bytes("true")};} return {status:200,body:text::into_bytes("false")};}
 if (req.path == "/is_char_boundary") {if (text::is_char_boundary(input,three)) {return {status:200,body:text::into_bytes("true")};} return {status:200,body:text::into_bytes("false")};}
 if (req.path == "/find") {let offset:option<u32> = text::find(input,"🦀"); let missing:u32 = 4294967295; let found:bool = offset.unwrap_or(missing) == three;if(found){return {status:200,body:text::into_bytes("true")};}return {status:200,body:text::into_bytes("false")};}
 if (req.path == "/rfind") {let offset:option<u32> = text::rfind(input,"雪"); let missing:u32 = 4294967295; let found:bool = offset.unwrap_or(missing) == seven;if(found){return {status:200,body:text::into_bytes("true")};}return {status:200,body:text::into_bytes("false")};}
 if (req.path == "/get") {return {status:200,body:text::into_bytes(text::get_or(input,zero,three,"missing"))};}
 if (req.path == "/get_invalid") {return {status:200,body:text::into_bytes(text::get_or(input,one,three,"missing"))};}
 if (req.path == "/strip_prefix") {return {status:200,body:text::into_bytes(text::strip_prefix_or(input,"prefix","missing"))};}
 if (req.path == "/strip_suffix") {return {status:200,body:text::into_bytes(text::strip_suffix_or(input,"suffix","missing"))};}
 if (req.path == "/from_utf8") {return {status:200,body:text::into_bytes(text::from_utf8_or(req.body,"invalid"))};}
 return {status:200,body:text::into_bytes(input)};
 }
}
world app {export api;}
