package local:json_compact_q2;
interface api {
  enum json_error {invalid_json,invalid_pointer,missing_target,type_mismatch,invalid_index,out_of_range,invalid_operation,allocation_failed}
  compact:func()->result<string,json_error> {return document::compact(" { \"a\" : 1 } ");}
  invalid:func()->result<string,json_error> {return document::compact("bad");}
}
world app {export api;}
