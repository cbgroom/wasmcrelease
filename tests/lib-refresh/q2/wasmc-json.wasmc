package local:current_json_q2;
interface api {
  enum json_error {input_too_large,depth_limit,invalid_json,too_many_pointers,pointer_too_long,invalid_pointer,output_too_large}
  compact:func()->result<string,json_error> {return document::compact(" { \"a\" : 1 } ");}
  invalid:func()->result<string,json_error> {return document::compact("bad");}
  select:func()->result<list<option<string>>,json_error> {
    let mut pointers:list<string> = list.new();
    pointers.push("/a");pointers.push("/missing");
    return document::select("{\"a\":2}",pointers);
  }
  validate:func()->result<unit,json_error> {return document::validate("{\"a\":2}");}
  reject:func()->result<unit,json_error> {return document::validate("bad");}
  unicode:func()->result<string,json_error> {return document::compact(" { \"msg\" : \"你好🌍\" } ");}
  empty_selection:func()->result<list<option<string>>,json_error> {
    let mut pointers:list<string> = list.new();
    return document::select("{}",pointers);
  }
  null_value:func()->result<list<option<string>>,json_error> {
    let mut pointers:list<string> = list.new();
    pointers.push("/a");pointers.push("/absent");
    return document::select("{\"a\":null}",pointers);
  }
  bad_pointer:func()->result<list<option<string>>,json_error> {
    let mut pointers:list<string> = list.new();pointers.push("not/a/pointer");
    return document::select("{}",pointers);
  }
}
world app {export api;}
