{
  "schema": "wasmc.system-profile-request/v2",
  "id": "ios-websocket-v1",
  "target": {
    "os": "ios",
    "architecture": "aarch64",
    "environment": "simulator",
    "embedding": "native"
  },
  "boundary": "wasmc.lib-defined-host-boundary/v1",
  "host": {
    "contract": "wasmc.lib-defined-host-boundary/v1",
    "executor": "host/tests/ios-app-capability/Host/FixedHost.swift",
    "required_domain_apis": 0
  },
  "required_lifecycle": "source",
  "requirements": [
    "wasmc:system-websocket@0.0.1"
  ],
  "pins": {},
  "acceptance": {
    "foreground_text_duplex": true,
    "finite_background_text_duplex": true,
    "local_pinned_wss": true,
    "service_restart_reconnect": true,
    "reconnect_policy": "350ms-fixed-max-8",
    "outbox_scope": "process-memory-single-message-fixture",
    "durable_outbox": "json-atomic-two-message-ordered-ack-drain",
    "process_relaunch_reconnect": true,
    "crash_before_ack_replay": true,
    "idempotent_effect_once": true,
    "idempotency_scope": "two-stable-message-ids-server-retained-fixture",
    "public_ca_wss": false,
    "internet_route": false,
    "suspension_receive": false
  },
  "sources": [
    "libspec/wasmc-system-ios-websocket/lib.json"
  ]
}
