{
  "schema": "wasmc.host-platform-providers/v1",
  "platform": "linux",
  "providers": [
    {
      "capability": "file",
      "domain": "storage",
      "status": "qualified",
      "binding": "shared-native-rust",
      "implementation": "host/drivers/file/rust",
      "qualification": {
        "workflow": ".github/workflows/host-file-io.yml",
        "jobs": ["ubuntu-24.04", "ubuntu-24.04-arm"],
        "architectures": ["x86_64", "aarch64"]
      }
    },
    {
      "capability": "memory",
      "status": "qualified",
      "binding": "shared-native-rust",
      "implementation": "host/drivers/memory/rust",
      "qualification": {
        "workflow": ".github/workflows/host-memory.yml",
        "jobs": ["ubuntu-24.04", "ubuntu-24.04-arm"],
        "architectures": ["x86_64", "aarch64"]
      }
    },
    {
      "capability": "tcp",
      "status": "unqualified"
    },
    {
      "capability": "udp",
      "status": "unqualified"
    }
  ]
}
