{
  "schema": "wasmc.host-platform-providers/v1",
  "platform": "macos",
  "providers": [
    {
      "capability": "file",
      "domain": "storage",
      "status": "qualified",
      "binding": "shared-native-rust",
      "implementation": "host/drivers/file/rust",
      "qualification": {
        "workflow": ".github/workflows/host-file-io.yml",
        "jobs": ["macos-14", "macos-15-intel"],
        "architectures": ["aarch64", "x86_64"]
      }
    },
    {
      "capability": "memory",
      "status": "unqualified"
    },
    {
      "capability": "tcp",
      "status": "unqualified"
    },
    {
      "capability": "udp",
      "status": "unqualified"
    }
  ]
}
