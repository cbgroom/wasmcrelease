package local:std_mix_large;

interface std_math {
  double_s32: func(value: s32) -> s32;
  abs_s32: func(value: s32) -> s32;
}

interface std_string {
  len: func(value: string) -> u32;
  is_empty: func(value: string) -> bool;
  contains: func(value: string, needle: string) -> bool;
  index_of: func(value: string, needle: string) -> s32;
  count_matches: func(value: string, needle: string) -> u32;
  slice: func(value: string, start: u32, len: u32) -> string;
  trim: func(value: string) -> string;
  replace: func(value: string, from: string, to: string) -> string;
  concat: func(a: string, b: string) -> string;
  starts_with: func(value: string, prefix: string) -> bool;
  ends_with: func(value: string, suffix: string) -> bool;
  eq: func(a: string, b: string) -> bool;
}

interface std_list {
  sum_s32: func(xs: list<s32>) -> s32;
  min_s32: func(xs: list<s32>) -> s32;
  max_s32: func(xs: list<s32>) -> s32;
  get_or_list_s32: func(xs: list<s32>, index: u32, default: s32) -> s32;
  first_s32: func(xs: list<s32>) -> s32;
  last_s32: func(xs: list<s32>) -> s32;
  contains_s32: func(xs: list<s32>, value: s32) -> bool;
  any_positive_s32: func(xs: list<s32>) -> bool;
  all_positive_s32: func(xs: list<s32>) -> bool;
  count_positive_s32: func(xs: list<s32>) -> u32;
  any_negative_s32: func(xs: list<s32>) -> bool;
  all_negative_s32: func(xs: list<s32>) -> bool;
  count_negative_s32: func(xs: list<s32>) -> u32;
}

interface std_map {
  has_s32: func(values: map<string, s32>, key: string) -> bool;
  get_or_s32: func(values: map<string, s32>, key: string, default: s32) -> s32;
  count_present_s32: func(values: map<string, s32>, keys: list<string>) -> u32;
  count_missing_s32: func(values: map<string, s32>, keys: list<string>) -> u32;
  any_present_s32: func(values: map<string, s32>, keys: list<string>) -> bool;
  any_missing_s32: func(values: map<string, s32>, keys: list<string>) -> bool;
  all_present_s32: func(values: map<string, s32>, keys: list<string>) -> bool;
  all_missing_s32: func(values: map<string, s32>, keys: list<string>) -> bool;
  sum_present_s32: func(values: map<string, s32>, keys: list<string>) -> s32;
}

interface api {
  record request { tenant: s32, risk: s32, quota: s32, bias: s32 }
  record decision { route: s32, score: s32, confidence: s32 }
  enum action { deny, review, allow }
  base_score: func(req: request) -> s32 { return abs_s32(req.risk) + req.quota + double_s32(req.bias); }

  string_gate_0: func(name: string, needle: string, prefix: string, suffix: string) -> s32 {
    let pos: s32 = index_of(name, needle);
    if (eq(trim(name), needle)) { return pos + 100; }
    if (contains(replace(name, needle, prefix), prefix)) { return pos + 20; }
    if (starts_with(concat(prefix, name), prefix)) { return pos + 10; }
    if (ends_with(concat(name, suffix), suffix)) { return pos + 5; }
    if (count_matches(slice(name, 0, 1), needle) > 0) { return pos + 1; }
    if (is_empty(name)) { return 0; }
    if (len(name) > 0) { return pos + 0; }
    return pos;
  }
  list_gate_0: func(flags: list<s32>) -> s32 {
    let total: s32 = sum_s32(flags) + get_or_list_s32(flags, 0, 1);
    if (contains_s32(flags, 1)) { return total + first_s32(flags); }
    if (any_positive_s32(flags)) { return total + max_s32(flags); }
    if (all_positive_s32(flags)) { return total + min_s32(flags); }
    if (count_positive_s32(flags) > 0) { return total + last_s32(flags); }
    if (any_negative_s32(flags)) { return total - min_s32(flags); }
    if (all_negative_s32(flags)) { return total - max_s32(flags); }
    if (count_negative_s32(flags) > 0) { return total - last_s32(flags); }
    return total;
  }
  map_gate_0: func(values: map<string, s32>, keys: list<string>, key: string) -> s32 {
    let base: s32 = get_or_s32(values, key, 1) + sum_present_s32(values, keys);
    if (has_s32(values, key)) { return base + 0; }
    if (all_present_s32(values, keys)) { return base + 20; }
    if (any_present_s32(values, keys)) { return base + 10; }
    if (any_missing_s32(values, keys)) { return base - 1; }
    if (all_missing_s32(values, keys)) { return base - 20; }
    if (count_present_s32(values, keys) > 0) { return base + 0; }
    if (count_missing_s32(values, keys) > 0) { return base - 0; }
    return base;
  }
  decision_0: func(req: request, flags: list<s32>, values: map<string, s32>, keys: list<string>, key: string, name: string, needle: string, prefix: string, suffix: string) -> s32 {
    let score: s32 = base_score(req) + string_gate_0(name, needle, prefix, suffix) + list_gate_0(flags) + map_gate_0(values, keys, key);
    if (score > 200) { return score + 90; }
    if (score > 100) { return score + 60; }
    return score + 30;
  }

  string_gate_1: func(name: string, needle: string, prefix: string, suffix: string) -> s32 {
    let pos: s32 = index_of(name, needle);
    if (eq(trim(name), needle)) { return pos + 101; }
    if (contains(replace(name, needle, prefix), prefix)) { return pos + 21; }
    if (starts_with(concat(prefix, name), prefix)) { return pos + 11; }
    if (ends_with(concat(name, suffix), suffix)) { return pos + 6; }
    if (count_matches(slice(name, 0, 2), needle) > 0) { return pos + 2; }
    if (is_empty(name)) { return 0; }
    if (len(name) > 1) { return pos + 1; }
    return pos;
  }
  list_gate_1: func(flags: list<s32>) -> s32 {
    let total: s32 = sum_s32(flags) + get_or_list_s32(flags, 1, 2);
    if (contains_s32(flags, 2)) { return total + first_s32(flags); }
    if (any_positive_s32(flags)) { return total + max_s32(flags); }
    if (all_positive_s32(flags)) { return total + min_s32(flags); }
    if (count_positive_s32(flags) > 1) { return total + last_s32(flags); }
    if (any_negative_s32(flags)) { return total - min_s32(flags); }
    if (all_negative_s32(flags)) { return total - max_s32(flags); }
    if (count_negative_s32(flags) > 1) { return total - last_s32(flags); }
    return total;
  }
  map_gate_1: func(values: map<string, s32>, keys: list<string>, key: string) -> s32 {
    let base: s32 = get_or_s32(values, key, 2) + sum_present_s32(values, keys);
    if (has_s32(values, key)) { return base + 1; }
    if (all_present_s32(values, keys)) { return base + 21; }
    if (any_present_s32(values, keys)) { return base + 11; }
    if (any_missing_s32(values, keys)) { return base - 2; }
    if (all_missing_s32(values, keys)) { return base - 21; }
    if (count_present_s32(values, keys) > 1) { return base + 1; }
    if (count_missing_s32(values, keys) > 1) { return base - 1; }
    return base;
  }
  decision_1: func(req: request, flags: list<s32>, values: map<string, s32>, keys: list<string>, key: string, name: string, needle: string, prefix: string, suffix: string) -> s32 {
    let score: s32 = base_score(req) + string_gate_1(name, needle, prefix, suffix) + list_gate_1(flags) + map_gate_1(values, keys, key);
    if (score > 201) { return score + 91; }
    if (score > 101) { return score + 61; }
    return score + 31;
  }

