    let score: s32 = base_score(req) + string_gate_45(name, needle, prefix, suffix) + list_gate_45(flags) + map_gate_45(values, keys, key);
    if (score > 245) { return score + 95; }
    if (score > 145) { return score + 65; }
    return score + 35;
  }

  string_gate_46: func(name: string, needle: string, prefix: string, suffix: string) -> s32 {
    let pos: s32 = index_of(name, needle);
    if (eq(trim(name), needle)) { return pos + 146; }
    if (contains(replace(name, needle, prefix), prefix)) { return pos + 66; }
    if (starts_with(concat(prefix, name), prefix)) { return pos + 56; }
    if (ends_with(concat(name, suffix), suffix)) { return pos + 51; }
    if (count_matches(slice(name, 0, 3), needle) > 0) { return pos + 3; }
    if (is_empty(name)) { return 0; }
    if (len(name) > 1) { return pos + 1; }
    return pos;
  }
  list_gate_46: func(flags: list<s32>) -> s32 {
    let total: s32 = sum_s32(flags) + get_or_list_s32(flags, 1, 3);
    if (contains_s32(flags, 3)) { return total + first_s32(flags); }
    if (any_positive_s32(flags)) { return total + max_s32(flags); }
    if (all_positive_s32(flags)) { return total + min_s32(flags); }
    if (count_positive_s32(flags) > 1) { return total + last_s32(flags); }
    if (any_negative_s32(flags)) { return total - min_s32(flags); }
    if (all_negative_s32(flags)) { return total - max_s32(flags); }
    if (count_negative_s32(flags) > 1) { return total - last_s32(flags); }
    return total;
  }
  map_gate_46: func(values: map<string, s32>, keys: list<string>, key: string) -> s32 {
    let base: s32 = get_or_s32(values, key, 3) + sum_present_s32(values, keys);
    if (has_s32(values, key)) { return base + 46; }
    if (all_present_s32(values, keys)) { return base + 66; }
    if (any_present_s32(values, keys)) { return base + 56; }
    if (any_missing_s32(values, keys)) { return base - 3; }
    if (all_missing_s32(values, keys)) { return base - 66; }
    if (count_present_s32(values, keys) > 1) { return base + 1; }
    if (count_missing_s32(values, keys) > 1) { return base - 1; }
    return base;
  }
  decision_46: func(req: request, flags: list<s32>, values: map<string, s32>, keys: list<string>, key: string, name: string, needle: string, prefix: string, suffix: string) -> s32 {
    let score: s32 = base_score(req) + string_gate_46(name, needle, prefix, suffix) + list_gate_46(flags) + map_gate_46(values, keys, key);
    if (score > 246) { return score + 96; }
    if (score > 146) { return score + 66; }
    return score + 36;
  }

  string_gate_47: func(name: string, needle: string, prefix: string, suffix: string) -> s32 {
    let pos: s32 = index_of(name, needle);
    if (eq(trim(name), needle)) { return pos + 147; }
    if (contains(replace(name, needle, prefix), prefix)) { return pos + 67; }
    if (starts_with(concat(prefix, name), prefix)) { return pos + 57; }
    if (ends_with(concat(name, suffix), suffix)) { return pos + 52; }
    if (count_matches(slice(name, 0, 4), needle) > 0) { return pos + 4; }
    if (is_empty(name)) { return 0; }
    if (len(name) > 2) { return pos + 2; }
    return pos;
  }
  list_gate_47: func(flags: list<s32>) -> s32 {
    let total: s32 = sum_s32(flags) + get_or_list_s32(flags, 2, 4);
    if (contains_s32(flags, 4)) { return total + first_s32(flags); }
    if (any_positive_s32(flags)) { return total + max_s32(flags); }
    if (all_positive_s32(flags)) { return total + min_s32(flags); }
    if (count_positive_s32(flags) > 2) { return total + last_s32(flags); }
    if (any_negative_s32(flags)) { return total - min_s32(flags); }
    if (all_negative_s32(flags)) { return total - max_s32(flags); }
    if (count_negative_s32(flags) > 2) { return total - last_s32(flags); }
    return total;
  }
  map_gate_47: func(values: map<string, s32>, keys: list<string>, key: string) -> s32 {
    let base: s32 = get_or_s32(values, key, 4) + sum_present_s32(values, keys);
    if (has_s32(values, key)) { return base + 47; }
    if (all_present_s32(values, keys)) { return base + 67; }
    if (any_present_s32(values, keys)) { return base + 57; }
    if (any_missing_s32(values, keys)) { return base - 4; }
    if (all_missing_s32(values, keys)) { return base - 67; }
    if (count_present_s32(values, keys) > 2) { return base + 2; }
    if (count_missing_s32(values, keys) > 2) { return base - 2; }
    return base;
  }
  decision_47: func(req: request, flags: list<s32>, values: map<string, s32>, keys: list<string>, key: string, name: string, needle: string, prefix: string, suffix: string) -> s32 {
    let score: s32 = base_score(req) + string_gate_47(name, needle, prefix, suffix) + list_gate_47(flags) + map_gate_47(values, keys, key);
    if (score > 247) { return score + 97; }
    if (score > 147) { return score + 67; }
    return score + 37;
  }

  aggregate: func(req: request, flags: list<s32>, values: map<string, s32>, keys: list<string>, key: string, name: string, needle: string, prefix: string, suffix: string) -> s32 {
    let head: s32 = decision_0(req, flags, values, keys, key, name, needle, prefix, suffix) + decision_1(req, flags, values, keys, key, name, needle, prefix, suffix) + decision_2(req, flags, values, keys, key, name, needle, prefix, suffix) + decision_3(req, flags, values, keys, key, name, needle, prefix, suffix) + decision_4(req, flags, values, keys, key, name, needle, prefix, suffix) + decision_5(req, flags, values, keys, key, name, needle, prefix, suffix) + decision_6(req, flags, values, keys, key, name, needle, prefix, suffix) + decision_7(req, flags, values, keys, key, name, needle, prefix, suffix);
    return head + decision_47(req, flags, values, keys, key, name, needle, prefix, suffix);
  }
}

