interface deps {
  host_metric_0: func(tenant: s32, key: s32) -> s32;
  host_metric_1: func(tenant: s32, key: s32) -> s32;
  host_metric_2: func(tenant: s32, key: s32) -> s32;
  host_metric_3: func(tenant: s32, key: s32) -> s32;
  host_metric_4: func(tenant: s32, key: s32) -> s32;
  host_metric_5: func(tenant: s32, key: s32) -> s32;
  host_metric_6: func(tenant: s32, key: s32) -> s32;
  host_metric_7: func(tenant: s32, key: s32) -> s32;
}

interface std_list {
  sum_s32: func(xs: list<s32>) -> s32;
  count_positive_s32: func(xs: list<s32>) -> u32;
  get_or_list_s32: func(xs: list<s32>, index: u32, default: s32) -> s32;
}

interface std_map {
  get_or_s32: func(values: map<string, s32>, key: string, default: s32) -> s32;
  count_present_s32: func(values: map<string, s32>, keys: list<string>) -> u32;
  sum_present_s32: func(values: map<string, s32>, keys: list<string>) -> s32;
}

