package local:system_telemetry_policy;

interface api {
  classify: func(cpu_milli_pct: s32, memory_available_mib: s32, rx_kib_per_s: s32, dropped_samples: s32) -> s32 {
    if (dropped_samples > 0) { return 4; }
    if (memory_available_mib < 512) { return 3; }
    if (cpu_milli_pct > 90000) { return 2; }
    if (rx_kib_per_s > 1048576) { return 1; }
    return 0;
  }
}

world app { export api; }
